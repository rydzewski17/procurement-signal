---
// The homepage right rail, in the agreed order. Pages can show a subset.
import SoftwareWidget from '../SoftwareWidget.astro';
import Line from './Line.astro';
import { getCollection } from 'astro:content';
import events from '../../data/events.json';
import conferences from '../../data/conferences.json';
import { categories, fmtPct, STATUS } from '../../data/costs';
import { ourItems, feedFor } from '../../data/feed';

interface Props { posts: any[]; show?: string[]; exclude?: Set<string> }
const { posts, show = ['software', 'popular', 'analysis', 'moves', 'guides', 'events', 'outlook', 'ad'], exclude = new Set() } = Astro.props;
const DAY = 864e5;
const newest = posts[0]?.data.date.valueOf() ?? 0;
// Most popular: until reader analytics are connected, ranked by our signal score and freshness.
const popPool = posts.filter((p) => !exclude.has(`/articles/${p.id}/`)).length >= 5 ? posts.filter((p) => !exclude.has(`/articles/${p.id}/`)) : posts;
const popular = [...popPool].sort((a, b) => (b.data.signal * 2 - (newest - b.data.date.valueOf()) / DAY) - (a.data.signal * 2 - (newest - a.data.date.valueOf()) / DAY)).slice(0, 5);
const guides = await getCollection('guides');
const popHrefs = new Set(popular.map((p) => `/articles/${p.id}/`));
// Company moves: our stories on deals, investments and supplier news.
const moves = feedFor(posts, ['deals'], new Set([...exclude, ...popHrefs])).slice(0, 4);
const movesFill = moves.length >= 3 ? moves : feedFor(posts, ['deals'], popHrefs).slice(0, 4);
// Analysis: our signal reports and analysis pieces.
const analysisAll = ourItems(posts.filter((p) => p.data.type !== 'news')).filter((x) => !popHrefs.has(x.href) && !movesFill.some((m) => m.href === x.href));
const analysisFresh = analysisAll.filter((x) => !exclude.has(x.href));
const analysis = (analysisFresh.length >= 3 ? analysisFresh : analysisAll).slice(0, 4);
const today = new Date().toISOString().slice(0, 10);
const upcoming = events.events.filter((e) => e.date >= today).sort((a, b) => a.date.localeCompare(b.date)).slice(0, 3);
const confs = conferences.events.filter((c) => c.end >= today).sort((a, b) => a.start.localeCompare(b.start)).slice(0, 3);
const span = (a: string, b: string) => {
  const f = (d: string, o: Intl.DateTimeFormatOptions) => new Date(d + 'T00:00:00Z').toLocaleDateString('en-US', { ...o, timeZone: 'UTC' });
  return a.slice(0, 7) === b.slice(0, 7) ? `${f(a, { month: 'short', day: 'numeric' })}–${f(b, { day: 'numeric' })}, ${a.slice(0, 4)}` : `${f(a, { month: 'short', day: 'numeric' })}–${f(b, { month: 'short', day: 'numeric', year: 'numeric' })}`;
};
const days = (d: string) => Math.round((Date.parse(d + 'T00:00:00Z') - Date.parse(today + 'T00:00:00Z')) / DAY);
const longDate = (d: string) => new Date(d + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' });
const movers = [...categories].sort((a, b) => Math.abs(b.m3ann) - Math.abs(a.m3ann)).slice(0, 5);
const on = (k: string) => show.includes(k);
---
<aside class="rail4" aria-label="More from Procurement Signal">
  {on('software') && <SoftwareWidget />}

  {on('popular') && popular.length > 0 && (
    <section class="rmod">
      <h2>Most popular</h2>
      <ol class="pop">{popular.map((p) => <li><a href={`/articles/${p.id}/`}>{p.data.title}</a></li>)}</ol>
    </section>
  )}

  {on('guides') && guides.length > 0 && (
    <section class="rmod">
      <h2>Guides and playbooks</h2>
      <ul class="lines">{guides.map((g) => <li class="line own"><a href={`/guides/${g.id}/`}>{g.data.title}</a><span>Guide, updated {g.data.updated.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span></li>)}</ul>
      <a class="rmore" href="/guides/">All guides and the glossary</a>
    </section>
  )}

  {on('analysis') && analysis.length > 0 && (
    <section class="rmod">
      <h2>Analysis and signal reports</h2>
      <ul class="lines lines-thumb">{analysis.map((x) => <Line item={x} thumb />)}</ul>
      <a class="rmore" href="/signals/">All signal reports</a>
    </section>
  )}

  {on('moves') && movesFill.length > 0 && (
    <section class="rmod">
      <h2>Company moves</h2>
      <ul class="lines lines-thumb">{movesFill.map((x) => <Line item={x} thumb />)}</ul>
      <a class="rmore" href="/categories/deals/">More company news</a>
    </section>
  )}

  {on('events') && (upcoming.length > 0 || confs.length > 0) && (
    <section class="rmod">
      <h2>Key dates and events</h2>
      <ul class="dates">
        {upcoming.map((e) => (
          <li class={days(e.date) <= 30 ? 'soon' : ''}>
            <span class="dnum" data-date={e.date}><b>{days(e.date)}</b><small>{days(e.date) === 1 ? 'day' : 'days'}</small></span>
            <span><a href={e.href}>{e.label}</a><small>{longDate(e.date)}</small></span>
          </li>
        ))}
      </ul>
      {confs.length > 0 && (
        <ul class="confs">
          {confs.map((c) => <li><a href={c.url} target="_blank" rel="noopener">{c.name}</a><small>{span(c.start, c.end)}, {c.place}</small></li>)}
        </ul>
      )}
      <a class="rmore" href="/trackers/tariff-deadlines/">All tariff deadlines</a>
    </section>
  )}

  {on('outlook') && (
    <section class="rmod">
      <h2>Market outlook</h2>
      <ul class="outl">
        {movers.map((c) => (
          <li>
            <a href={`/cost-monitor/${c.id}/`}>{c.name.split(' (')[0]}</a>
            <span class={`st st-${c.status}`}>{STATUS[c.status].label}</span>
            <span class="pct">{fmtPct(c.y1)}</span>
          </li>
        ))}
      </ul>
      <p class="rnote">Price change over 12 months, with our read on pressure.</p>
      <a class="rmore" href="/cost-monitor/">What it means for each category</a>
    </section>
  )}

  {on('ad') && <div class="ad-slot">Advertisement</div>}
</aside>
<script is:inline>
  document.querySelectorAll('.dates .dnum[data-date]').forEach((el) => {
    const now = new Date(); now.setHours(0, 0, 0, 0);
    const n = Math.round((new Date(el.dataset.date + 'T00:00:00') - now) / 864e5);
    if (n >= 0) { el.querySelector('b').textContent = n; el.querySelector('small').textContent = n === 1 ? 'day' : 'days'; }
  });
</script>
