---
// Lets a reader follow a category. Saved in the browser only (no account needed),
// so followed categories can be shown on return visits.
const { slug, name } = Astro.props;
---
<button class="follow" data-follow={slug} data-name={name} type="button" aria-pressed="false">Follow {name}</button>
<script is:inline define:vars={{ slug }}>
  (() => {
    const key = 'ps-follow';
    const read = () => { try { return JSON.parse(localStorage.getItem(key)) || []; } catch { return []; } };
    const write = (v) => { try { localStorage.setItem(key, JSON.stringify(v)); } catch {} };
    const btn = document.querySelector(`[data-follow="${slug}"]`);
    if (!btn) return;
    const paint = () => {
      const on = read().includes(slug);
      btn.setAttribute('aria-pressed', String(on));
      btn.textContent = on ? 'Following' : `Follow ${btn.dataset.name || ''}`.trim();
    };
    btn.addEventListener('click', () => {
      const list = read();
      write(list.includes(slug) ? list.filter((s) => s !== slug) : [...list, slug]);
      paint();
    });
    paint();
  })();
</script>
<style>
  .follow { font: 600 13px/1 var(--sans); background: #fff; color: #000; border: 1px solid #000; padding: 9px 14px; border-radius: 4px; cursor: pointer; }
  .follow[aria-pressed="true"] { background: #000; color: #fff; }
</style>
