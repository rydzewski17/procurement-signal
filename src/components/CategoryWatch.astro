---
// "Your categories this quarter": for each purchase category, who holds negotiating
// leverage, how much supply risk there is, the move we recommend and when to make it.
// Leverage, risk and the move are Procurement Signal's assessment; price is a supporting detail.
import { categoryOutlook, impactAsOf, LEVERAGE, RISK } from '../data/watch';
import { fmtPct } from '../data/costs';
const { posts, limit = 6, full = false } = Astro.props;
const rows = categoryOutlook(posts);
const groups = [...new Set(rows.map((r) => r.group))];
const asOf = new Date(impactAsOf + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' });
const counts = { suppliers: rows.filter((r) => r.leverage <= 2).length, procurement: rows.filter((r) => r.leverage >= 4).length, high: rows.filter((r) => r.risk === 'high').length };
---
<section class="cp-wrap" aria-labelledby="cp-h" data-limit={full ? 999 : limit}>
  <div class="cp-head">
    {full ? null : <h2 id="cp-h">Your categories this quarter<a class="view-all" href="/outlook/">Full category outlook</a></h2>}
    {full && <h2 id="cp-h" class="sr-only">Category outlook</h2>}
    <p>Who holds negotiating leverage, how exposed supply is, and the move we would make now in each category. Our assessment, updated {asOf}, built from the reporting and data linked on each card.</p>
    <div class="cp-sum" role="group" aria-label="Filter by risk and leverage">
      <button type="button" class="cps cps-high" data-g="risk-high"><b>{counts.high}</b><span>categories with high supply risk</span></button>
      <button type="button" class="cps cps-sup" data-g="lev-sup"><b>{counts.suppliers}</b><span>where suppliers have the edge</span></button>
      <button type="button" class="cps cps-proc" data-g="lev-proc"><b>{counts.procurement}</b><span>where procurement has the edge</span></button>
    </div>
    <div class="cp-filter" role="group" aria-label="Filter by category group">
      <button type="button" class="cpf on" data-g="all">All categories</button>
      {groups.map((g) => <button type="button" class="cpf" data-g={g}>{g}</button>)}
      <button type="button" class="cpf" data-g="lev">Balanced or better for procurement</button>
    </div>
    <p class="cp-showing" aria-live="polite"></p>
  </div>

  <div class="cp-grid">
    {rows.map((r) => (
      <article class="cp" id={full ? r.id : undefined} data-g={r.group} data-lev={r.leverage >= 3 ? 'y' : 'n'} data-tier={r.leverage <= 2 ? 'sup' : r.leverage >= 4 ? 'proc' : 'bal'} data-risk={r.risk} data-href={`/outlook/${r.id}/`}>
        <div class="cp-top">
          <div>
            <h3><a href={`/outlook/${r.id}/`}>{r.name}</a></h3>
            <small>{r.group}</small>
          </div>
          <span class={`cp-risk r-${r.risk}`}>{RISK[r.risk]}</span>
        </div>

        <div class="cp-lev">
          <div class="cp-lev-row"><span>Negotiating leverage</span><b>{LEVERAGE[r.leverage].label}</b></div>
          <div class="cp-scale" role="img" aria-label={`Leverage ${r.leverage} of 5: ${LEVERAGE[r.leverage].label}`}>
            {[1, 2, 3, 4, 5].map((n) => <i class={n === r.leverage ? 'on' : ''}></i>)}
          </div>
          <div class="cp-ends" aria-hidden="true"><span>Suppliers</span><span>Procurement</span></div>
        </div>

        {r.impact?.riskWhy && <p class="cp-why">{r.impact.riskWhy}</p>}

        <div class="cp-move">
          <span class="cp-lbl">Our move</span>
          <p>{r.impact?.move ?? r.posture}</p>
          {r.impact?.when && <span class="cp-when"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>{r.impact.when}</span>}
        </div>

        <div class="cp-foot">
          <span>Price: <a href={`/cost-monitor/${r.id}/`}>{fmtPct(r.y1)} over 12 months</a></span>
          {r.latest && <span class="cp-read">Read: <a href={r.latest.href}>{r.latest.title}</a></span>}
          <a class="cp-more" href={`/outlook/${r.id}/`}>Full {r.name.toLowerCase()} analysis <span aria-hidden="true">→</span></a>
          {full && r.impact?.sources?.length > 0 && (
            <span class="cp-src">Sources: {r.impact.sources.map((s: any, k: number) => <>{k > 0 && '; '}<a href={s.url}>{s.name.replace(/^Procurement Signal: /, '')}</a></>)}</span>
          )}
        </div>
      </article>
    ))}
  </div>
  {!full && <button type="button" class="cp-all">Show all {rows.length} categories</button>}
</section>

<script is:inline>
  (() => {
    document.querySelectorAll('.cp-wrap').forEach((root) => {
      const items = [...root.querySelectorAll('.cp')];
      const more = root.querySelector('.cp-all');
      const limit = +root.dataset.limit;
      let group = 'all', expanded = false;
      const apply = () => {
        let shown = 0;
        items.forEach((el) => {
          const inGroup = group === 'all'
            || (group === 'lev' ? el.dataset.lev === 'y'
            : group === 'risk-high' ? el.dataset.risk === 'high'
            : group === 'lev-sup' ? el.dataset.tier === 'sup'
            : group === 'lev-proc' ? el.dataset.tier === 'proc'
            : el.dataset.g === group);
          const visible = inGroup && (expanded || group !== 'all' || shown < limit);
          el.hidden = !visible; if (visible) shown++;
        });
        if (more) more.hidden = group !== 'all' || expanded || items.length <= limit;
        const label = root.querySelector(`[data-g="${group}"]`);
        if (showing) showing.innerHTML = group === 'all' ? '' : `Showing ${shown} of ${items.length} categories: <b>${label ? label.textContent.replace(/^\d+/, '').trim() : ''}</b>. <button type="button" class="cp-clear">Show all</button>`;
      };
      const showing = root.querySelector('.cp-showing');
      const pick = (g) => {
        group = group === g && g !== 'all' ? 'all' : g;
        root.querySelectorAll('.cpf, .cps').forEach((x) => x.classList.toggle('on', x.dataset.g === group));
        apply();
      };
      root.addEventListener('click', (e) => {
        const b = e.target.closest('.cpf, .cps'); if (b) { pick(b.dataset.g); return; }
        if (e.target.closest('.cp-clear')) { pick('all'); return; }
        const card = e.target.closest('.cp');
        if (card && !e.target.closest('a, button')) location.href = card.dataset.href;
      });
      if (more) more.addEventListener('click', () => { expanded = true; apply(); });
      apply();
    });
  })();
</script>

<style>
  .cp-wrap { margin: 44px 0 0; }
  .cp-head h2 { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; font: 700 26px/1.2 var(--head); margin: 0; padding: 12px 0 0; border-top: 3px solid var(--ink); }
  .cp-head h2 .view-all { font: 600 13.5px/1 var(--ui); color: var(--link); }
  .cp-head p { font-size: 15px; color: var(--muted); margin: 8px 0 14px; max-width: 74ch; }
  .cp-sum { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin: 0 0 14px; }
  .cps { display: flex; align-items: center; gap: 10px; text-align: left; background: #fff; border: 1px solid var(--rule); border-left: 4px solid var(--ink-2); padding: 10px 12px; cursor: pointer; font: 14px/1.3 var(--ui); color: var(--ink-2); }
  .cps b { font: 700 26px/1 var(--head); color: var(--ink); }
  .cps-high { border-left-color: #c0392b; } .cps-sup { border-left-color: #e08a6d; } .cps-proc { border-left-color: var(--teal); }
  .cps:hover { border-color: var(--ink); box-shadow: 0 4px 12px rgba(14,42,71,.08); }
  .cps.on { background: var(--ink); color: #fff; border-color: var(--ink); }
  .cps.on b { color: #fff; }
  .cp-showing { font: 13.5px var(--ui); color: var(--ink-2); margin: -4px 0 12px; }
  .cp-showing:empty { display: none; }
  .cp-clear { background: none; border: 0; padding: 0; color: var(--link); font: 600 13.5px var(--ui); cursor: pointer; text-decoration: underline; }
  .cp { cursor: pointer; transition: box-shadow .15s, border-color .15s; }
  .cp:hover { box-shadow: 0 8px 22px rgba(14,42,71,.12); border-color: #b9c7d5; }
  .cp-more { font: 600 13.5px var(--ui); color: var(--teal) !important; margin-top: 4px; text-decoration: none; }
  .cp-more:hover { text-decoration: underline; }
  @media (max-width: 680px) { .cp-sum { grid-template-columns: 1fr; } }
  .cp-filter { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }
  .cpf { font: 600 13px/1 var(--ui); padding: 8px 11px; border: 1px solid #b9c7d5; background: #fff; color: var(--ink); cursor: pointer; }
  .cpf:hover { border-color: var(--ink); }
  .cpf.on { background: var(--ink); color: #fff; border-color: var(--ink); }
  .cp-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .cp { display: flex; flex-direction: column; gap: 12px; background: #fff; border: 1px solid var(--rule); border-top: 3px solid var(--navy); padding: 16px 18px 14px; scroll-margin-top: 80px; }
  .cp[hidden] { display: none; }
  .cp-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
  .cp-top h3 { font: 700 19px/1.2 var(--head); margin: 0; }
  .cp-top h3 a { color: var(--ink); text-decoration: none; }
  .cp-top h3 a:hover { text-decoration: underline; }
  .cp-top small { font: 12.5px var(--ui); color: var(--muted); }
  .cp-risk { font: 600 12px/1 var(--ui); padding: 6px 8px; white-space: nowrap; }
  .r-high { background: #fbe9e7; color: #a3261b; }
  .r-elevated { background: #fff4dc; color: #8a5a00; }
  .r-low { background: #e3f4f1; color: #0b6b5f; }
  .cp-lev-row { display: flex; justify-content: space-between; gap: 10px; font: 13px/1.3 var(--ui); color: var(--muted); margin-bottom: 6px; }
  .cp-lev-row b { color: var(--ink); font-weight: 600; text-align: right; }
  .cp-scale { display: grid; grid-template-columns: repeat(5, 1fr); gap: 3px; }
  .cp-scale i { height: 8px; background: linear-gradient(90deg, #d9e1ea, #d9e1ea); }
  .cp-scale i:nth-child(1) { background: #f1c9c3; } .cp-scale i:nth-child(2) { background: #f6dccf; }
  .cp-scale i:nth-child(3) { background: #e3e8ee; } .cp-scale i:nth-child(4) { background: #cfe9e4; } .cp-scale i:nth-child(5) { background: #b6dfd7; }
  .cp-scale i.on { background: var(--navy); height: 12px; margin-top: -2px; box-shadow: 0 0 0 2px #fff, 0 0 0 3px var(--navy); }
  .cp-ends { display: flex; justify-content: space-between; font: 11.5px var(--ui); color: var(--muted); margin-top: 5px; }
  .cp-why { font: 15px/1.5 var(--head); color: var(--ink); margin: 0; }
  .cp-move { background: var(--navy-tint); border-left: 3px solid var(--teal); padding: 10px 12px; }
  .cp-lbl { font: 600 12px/1 var(--ui); color: var(--teal); }
  .cp-move p { font: 600 14.5px/1.45 var(--ui); color: var(--ink); margin: 4px 0 6px; }
  .cp-when { display: inline-flex; align-items: center; gap: 5px; font: 600 12.5px/1.2 var(--ui); color: var(--ink-2); }
  .cp-foot { display: flex; flex-direction: column; gap: 4px; margin-top: auto; padding-top: 10px; border-top: 1px solid var(--rule); font: 13px/1.4 var(--ui); color: var(--muted); }
  .cp-foot a { color: var(--link); }
  .cp-read a { color: var(--ink); font-weight: 500; }
  .cp-src { font-size: 12.5px; }
  .cp-all { margin-top: 16px; padding: 11px 16px; border: 1px solid var(--ink); background: #fff; color: var(--ink); font: 600 14px/1 var(--ui); cursor: pointer; }
  .cp-all:hover { background: var(--ink); color: #fff; }
  .cp-all[hidden] { display: none; }
  @media (max-width: 680px) { .cp-grid { grid-template-columns: 1fr; } }
</style>
