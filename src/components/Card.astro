---
import { TOPICS } from '../data/site';
const { post, size = 'river', showTopic = true } = Astro.props;
const d = post.data;
const date = d.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const href = `/articles/${post.id}/`;
---
{size === 'title' ? (
  <article><a href={href}><h4>{d.title}</h4></a></article>
) : size === 'stack' ? (
  <article>
    {showTopic && <a class="topic" href={`/topics/${d.topic}/`}>{TOPICS[d.topic].name}</a>}
    <a href={href}><h3>{d.title}</h3></a>
    <div class="date">{date}</div>
  </article>
) : (
  <article>
    {showTopic && <a class="topic" href={`/topics/${d.topic}/`}>{TOPICS[d.topic].name}</a>}
    <a href={href}><h2>{d.title}</h2></a>
    <p>{d.dek}</p>
    <div class="date">{date}</div>
  </article>
)}
