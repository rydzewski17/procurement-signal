---
// Single-series trend line, 24 months. The table row carries the numbers.
const { history, label } = Astro.props as { history: { date: string; value: number }[]; label: string };
const W = 140, H = 36, pad = 4;
const vals = history.map((h) => h.value);
const min = Math.min(...vals), max = Math.max(...vals);
const x = (i: number) => pad + (i * (W - pad * 2)) / (vals.length - 1);
const y = (v: number) => H - pad - ((v - min) / (max - min || 1)) * (H - pad * 2);
const d = vals.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join('');
const last = vals.length - 1;
---
<svg class="spark" viewBox={`0 0 ${W} ${H}`} width={W} height={H} role="img" aria-label={`${label}: 24-month trend`}>
  <path d={d} fill="none" stroke="var(--brand)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
  <circle cx={x(last)} cy={y(vals[last])} r="3.5" fill="var(--brand)" stroke="var(--paper)" stroke-width="2" />
</svg>
