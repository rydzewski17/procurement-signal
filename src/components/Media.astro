---
import Photo from './Photo.astro';
import { TOPIC_PHOTOS } from '../data/site';
const { post, ratio = 'card', caption = false, eager = false } = Astro.props;
const d = post.data;
const photo = d.image ?? TOPIC_PHOTOS[d.topic];
---
<Photo photo={photo} ratio={ratio} caption={caption} eager={eager} />
