---
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Card from '../../components/Card.astro';
import { getPosts } from '../../data/posts';
import { categories, meta, monthLabel, fmtPct, STATUS } from '../../data/costs';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { id: c.id }, props: { c } }));
}
const { c } = Astro.props;
const posts = await getPosts();
const words = c.name.toLowerCase().split(/\W+/).filter((w) => w.length > 4);
const related = posts.filter((p) => words.some((w) => (p.data.title + ' ' + p.data.tags.join(' ')).toLowerCase().includes(w))).slice(0, 3);
const others = categories.filter((o) => o.id !== c.id && o.group === c.group);

// Line chart geometry
const W = 760, H = 300, L = 48, R = 16, T = 16, B = 34;
const vals = c.history.map((h) => h.value);
const lo = Math.min(...vals), hi = Math.max(...vals), span = hi - lo || 1;
const yMin = lo - span * 0.1, yMax = hi + span * 0.1;
const x = (i: number) => L + (i * (W - L - R)) / (vals.length - 1);
const y = (v: number) => T + (1 - (v - yMin) / (yMax - yMin)) * (H - T - B);
const path = vals.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join('');
const ticks = Array.from({ length: 4 }, (_, k) => yMin + ((k + 0.5) * (yMax - yMin)) / 4);
const xTicks = c.history.map((h, i) => ({ i, h })).filter(({ i }) => i % 6 === 0 || i === vals.length - 1);
const points = c.history.map((h, i) => ({ x: x(i), y: y(h.value), label: monthLabel(h.date), value: h.value.toFixed(1) }));
const through = monthLabel(meta.dataThrough + '-01');
---
<Base title={`${c.name} prices: trend and buyer outlook`} description={`${c.name} producer prices are ${STATUS[c.status].label.toLowerCase()}: ${fmtPct(c.y1)} over 12 months. Trend, data and what procurement teams should do.`} section="cost-monitor">
  <div class="page">
    <div class="page-head narrow">
      <div class="crumbs"><a href="/cost-monitor/">Price trends by category</a>&ensp;/&ensp;{c.group}</div>
      <h1>{c.name}</h1>
      <p>Data through {through}. <StatusBadge status={c.status} /></p>
    </div>

    <dl class="keyfacts" style="--n:4;max-width:760px">
      <div><dt>{fmtPct(c.m1)}</dt><dd>change last month</dd></div>
      <div><dt>{fmtPct(c.m3ann)}</dt><dd>three-month pace, annualized</dd></div>
      <div><dt>{fmtPct(c.y1)}</dt><dd>change over 12 months</dd></div>
      <div><dt>{fmtPct(c.fromPeak)}</dt><dd>versus 12-month high</dd></div>
    </dl>

    <figure class="chart" data-points={JSON.stringify(points)}>
      <figcaption class="chart-title">Producer price index, last 24 months <span>({c.series})</span></figcaption>
      <div class="chart-wrap">
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${c.name} producer price index from ${monthLabel(c.history[0].date)} to ${through}`}>
          {ticks.map((t) => (
            <g>
              <line x1={L} x2={W - R} y1={y(t)} y2={y(t)} stroke="var(--rule)" />
              <text x={L - 8} y={y(t) + 4} text-anchor="end" class="axis">{t.toFixed(0)}</text>
            </g>
          ))}
          {xTicks.map(({ i, h }) => <text x={x(i)} y={H - 10} text-anchor={i === vals.length - 1 ? 'end' : 'middle'} class="axis">{monthLabel(h.date)}</text>)}
          <path d={path} fill="none" stroke="var(--brand)" stroke-width="2" stroke-linejoin="round" />
          <circle cx={x(vals.length - 1)} cy={y(vals[vals.length - 1])} r="4.5" fill="var(--brand)" stroke="var(--paper)" stroke-width="2" />
          <line class="cross" x1="0" x2="0" y1={T} y2={H - B} stroke="var(--muted)" stroke-dasharray="3 3" visibility="hidden" />
          <circle class="cross-dot" r="5" fill="var(--brand)" stroke="var(--paper)" stroke-width="2" visibility="hidden" />
          <rect class="hit" x={L} y={T} width={W - L - R} height={H - T - B} fill="transparent" />
        </svg>
        <div class="tip" hidden></div>
      </div>
    </figure>

    <div class="with-rail">
      <div class="prose-page">
        <h2>What it means for buyers</h2>
        <p>{STATUS[c.status].posture}</p>
        {c.tariff && <><h2>Tariff exposure</h2><p>{c.tariff}. Producer prices exclude import duties, so imported supply can cost more than this index shows. See the <a href="/trackers/tariff-deadlines/">Tariff &amp; Trade Deadline Tracker</a>.</p></>}
        <details class="datatable">
          <summary>View the data table</summary>
          <table>
            <thead><tr><th>Month</th><th class="num">Index</th></tr></thead>
            <tbody>{[...c.history].reverse().map((h) => <tr><td>{monthLabel(h.date)}</td><td class="num">{h.value.toFixed(1)}</td></tr>)}</tbody>
          </table>
        </details>
        <p class="meta">Source: U.S. Bureau of Labor Statistics, series <a href={`https://fred.stlouisfed.org/series/${c.series}`} target="_blank" rel="noopener">{c.series}</a> via FRED. <a href="/cost-monitor/#methodology">How we classify pressure</a>.</p>
      </div>
      <aside class="side">
        {others.length > 0 && <>
          <h2 class="block-head">Also in {c.group.toLowerCase()}</h2>
          <ul class="linklist">{others.map((o) => <li><a href={`/cost-monitor/${o.id}/`}>{o.name}</a><span class="date">{STATUS[o.status].label}, {fmtPct(o.y1)} on the year</span></li>)}</ul>
        </>}
        {related.length > 0 && <>
          <h2 class="block-head">Related coverage</h2>
          {related.map((p) => <Card post={p} size="thumb" />)}
        </>}
      </aside>
    </div>
  </div>
  <script is:inline>
    document.querySelectorAll('figure.chart').forEach((fig) => {
      const pts = JSON.parse(fig.dataset.points), svg = fig.querySelector('svg'), tip = fig.querySelector('.tip');
      const cross = svg.querySelector('.cross'), dot = svg.querySelector('.cross-dot'), hit = svg.querySelector('.hit');
      const show = (evt) => {
        const box = svg.getBoundingClientRect(), vb = svg.viewBox.baseVal, sx = vb.width / box.width;
        const mx = (evt.clientX - box.left) * sx;
        let best = pts[0]; for (const p of pts) if (Math.abs(p.x - mx) < Math.abs(best.x - mx)) best = p;
        cross.setAttribute('x1', best.x); cross.setAttribute('x2', best.x); cross.setAttribute('visibility', 'visible');
        dot.setAttribute('cx', best.x); dot.setAttribute('cy', best.y); dot.setAttribute('visibility', 'visible');
        tip.hidden = false; tip.innerHTML = '<strong>' + best.label + '</strong><br>Index ' + best.value;
        const left = best.x / sx, top = best.y / sx;
        tip.style.left = Math.min(Math.max(left, 60), box.width - 60) + 'px'; tip.style.top = Math.max(top - 56, 0) + 'px';
      };
      const hide = () => { tip.hidden = true; cross.setAttribute('visibility', 'hidden'); dot.setAttribute('visibility', 'hidden'); };
      hit.addEventListener('pointermove', show); hit.addEventListener('pointerleave', hide);
    });
  </script>
</Base>
