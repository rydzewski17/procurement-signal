---
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import wire from '../../data/wire.json';
import { getPosts } from '../../data/posts';
import { CATEGORIES, categorize } from '../../data/categories.mjs';
import { TOPICS } from '../../data/site';
import FollowButton from '../../components/FollowButton.astro';

export async function getStaticPaths() {
  const posts = await getPosts();
  return CATEGORIES.map((c) => ({
    params: { slug: c.slug },
    props: {
      c,
      posts: posts.filter((p) => categorize(`${p.data.title} ${p.data.dek}`).includes(c.slug)),
    },
  }));
}

const { c, posts } = Astro.props;
const headlines = wire.items.filter((i: any) => (i.categories ?? []).includes(c.slug));
const fmt = (d: Date | string) => new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' });
const related = CATEGORIES.filter((r) => r.slug !== c.slug).slice(0, 10);
---
<Base title={c.name} description={c.blurb} section="categories">
  <div class="page">
    <div class="crumbs"><a href="/categories/">Categories</a> / {c.name}</div>
    <div class="page-head">
      <h1>{c.name}</h1>
      <p>{c.blurb}</p>
      <div style="margin-top:14px"><FollowButton slug={c.slug} name={c.name} /></div>
    </div>

    <div class="cat-layout">
      <div>
        <div class="band-title"><span>From Procurement Signal</span></div>
        {posts.length === 0 ? <p class="empty">No analysis in this category yet. Headlines from the trade press are below.</p> : (
          <div class="feed">
            {posts.map((p) => (
              <article class="row">
                <div>
                  <span class="topic">{TOPICS[p.data.topic].name}</span>
                  <h2><a href={`/articles/${p.id}/`}>{p.data.title}</a></h2>
                  <p>{p.data.dek}</p>
                  <span class="date">{fmt(p.data.date)}</span>
                </div>
                <a href={`/articles/${p.id}/`} tabindex="-1" aria-hidden="true" class="thumb"><Media post={p} ratio="card" /></a>
              </article>
            ))}
          </div>
        )}

        <div class="band-title" style="margin-top:36px"><span>From the trade press</span><a href="/wire/">Full wire →</a></div>
        {headlines.length === 0 ? <p class="empty">No headlines in this category in the last week.</p> : (
          <ul class="wire">
            {headlines.map((h: any) => (
              <li>
                <a href={h.url} target="_blank" rel="noopener">{h.title}</a>
                <span class="date">{h.source}{h.official ? ' (official notice)' : ''} · {fmt(h.date)}</span>
              </li>
            ))}
          </ul>
        )}
      </div>

      <aside>
        <div class="band-title"><span>Other categories</span></div>
        <div class="chips">
          {related.map((r) => <a class="chip" href={`/categories/${r.slug}/`}>{r.name}</a>)}
        </div>
        <div class="band-title" style="margin-top:30px"><span>Tools and rankings</span></div>
        <ul class="linklist">
          <li><a href="/software/">Software rankings</a></li>
          <li><a href="/software/finder/">Software finder</a></li>
          <li><a href="/cost-monitor/">Cost pressure monitor</a></li>
          <li><a href="/markets/">Market odds</a></li>
        </ul>
      </aside>
    </div>
  </div>
</Base>

<style>
  .crumbs { font-size: 13px; color: var(--muted); margin-top: 22px; }
  .crumbs a { color: var(--accent); text-decoration: none; }
  .cat-layout { display: grid; grid-template-columns: minmax(0,1fr) 300px; gap: 40px; margin-top: 10px; }
  .band-title { font: 800 13px/1 var(--sans); text-transform: uppercase; letter-spacing: .06em; border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 8px; display: flex; justify-content: space-between; }
  .band-title a { font-size: 12px; text-transform: none; letter-spacing: 0; color: var(--accent); text-decoration: none; font-weight: 600; }
  .feed .row { display: grid; grid-template-columns: minmax(0,1fr) 170px; gap: 20px; padding: 18px 0; border-bottom: 1px solid var(--rule); }
  .feed h2 { font: 700 20px/1.3 var(--sans); margin: 6px 0; }
  .feed h2 a { text-decoration: none; }
  .feed h2 a:hover { text-decoration: underline; }
  .feed p { font-size: 15px; color: var(--ink-2); margin: 0 0 6px; }
  .feed .thumb img { width: 170px; height: 105px; object-fit: cover; display: block; }
  .wire { list-style: none; margin: 0; padding: 0; }
  .wire li { padding: 12px 0; border-bottom: 1px solid var(--rule); }
  .wire a { font: 600 16px/1.35 var(--sans); text-decoration: none; }
  .wire a:hover { text-decoration: underline; }
  .wire .date { display: block; font-size: 12px; color: var(--muted); margin-top: 4px; }
  .empty { color: var(--muted); font-size: 15px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { font-size: 13px; border: 1px solid var(--rule); padding: 6px 10px; text-decoration: none; color: var(--ink-2); }
  .chip:hover { border-color: #000; color: #000; }
  .linklist { list-style: none; margin: 0; padding: 0; }
  .linklist li { padding: 9px 0; border-bottom: 1px solid var(--rule); font-size: 14px; }
  .linklist a { text-decoration: none; }
  @media (max-width: 900px) { .cat-layout { grid-template-columns: 1fr; } .feed .row { grid-template-columns: 1fr; } .feed .thumb { display: none; } }
</style>
