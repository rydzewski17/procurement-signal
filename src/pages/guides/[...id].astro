---
// Guide page. Same structure as an article: header, photo, summary box, body,
// FAQ, method and sources, with the "On this page" menu and rail on the right,
// and related reading at the end.
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Rail from '../../components/v4/Rail.astro';
import Tile from '../../components/v4/Tile.astro';
import AdMesh from '../../components/AdMesh.astro';
import { getPosts } from '../../data/posts';
import { slugify } from '../../data/tags';
import { linkInternal, linkSources } from '../../data/autolinks';
import { linkVendors } from '../../data/vendorlinks';
import { ourItems, clip } from '../../data/feed';
import { SITE, TOPICS, TOPIC_PHOTOS } from '../../data/site';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({ params: { id: g.id }, props: { g, guides } }));
}
const { g, guides } = Astro.props;
const d = g.data;
const { headings } = await render(g);
const toc = headings.filter((h) => h.depth === 2);
const self = `/guides/${g.id}/`;
const bodyHtml = linkSources(linkInternal(linkVendors(g.rendered?.html ?? ''), self), d.sources);
const posts = await getPosts();
const myTags = new Set(d.tags.map(slugify));
const scored = posts.map((p) => ({ p, s: p.data.tags.filter((t) => myTags.has(slugify(t))).length * 3 + (p.data.topic === d.topic ? 2 : 0) + p.data.signal / 5 }))
  .sort((a, b) => b.s - a.s).map((x) => x.p);
const related = ourItems(scored).slice(0, 6);
const otherGuides = guides.filter((o) => o.id !== g.id).sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());
const words = g.body ? g.body.split(/\s+/).length : 0;
const mins = Math.max(1, Math.round(words / 230));
const fmt = (x: Date) => x.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const url = new URL(self, Astro.site).toString();
const enc = encodeURIComponent;
const topicName = TOPICS[d.topic]?.name ?? 'Guides';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Article', headline: d.title, description: d.description, dateModified: d.updated.toISOString(), wordCount: words,
      author: { '@type': 'Organization', name: `${SITE.name} Editors` }, publisher: { '@type': 'Organization', name: SITE.name }, mainEntityOfPage: url,
      citation: d.sources.map((x) => ({ '@type': 'CreativeWork', name: x.name, url: x.url })) },
    ...(d.faqs.length ? [{ '@type': 'FAQPage', mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: d.title, item: url } ] },
  ],
};
---
<Base title={d.title} description={d.description} type="article" jsonLd={jsonLd} section="guides">
  <div class="article-layout">
    <article class="article" data-pagefind-body>
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/guides/">Guides</a> / <a href={`/topics/${d.topic}/`}>{topicName}</a></nav>
      <span class="guide-kicker">Guide</span>
      <h1>{d.title}</h1>
      <p class="dek">{d.description}</p>
      <div class="byline">
        <div>
          <div class="who">By {SITE.name} Editors</div>
          <div class="when">Last reviewed {fmt(d.updated)}</div>
          <div class="read-meta">{mins} min read</div>
        </div>
        <div class="share">
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`} target="_blank" rel="noopener">LinkedIn</a>
          <a href={`https://x.com/intent/post?url=${enc(url)}&text=${enc(d.title)}`} target="_blank" rel="noopener">X</a>
          <a href={`mailto:?subject=${enc(d.title)}&body=${enc(url)}`}>Email</a>
          <button type="button" class="copy-link" data-url={url}>Copy link</button>
        </div>
      </div>
      <Photo photo={TOPIC_PHOTOS[d.topic]} ratio="wide" caption eager />

      <section class="art-summary" aria-label="Key takeaways">
        <h2>Key takeaways</h2>
        <ul>{d.takeaways.map((t) => <li>{t}</li>)}</ul>
      </section>

      {toc.length > 0 && (
        <details class="toc-mobile">
          <summary>In this guide</summary>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </details>
      )}

      <div class="prose" set:html={bodyHtml} />

      {d.faqs.length > 0 && (
        <section class="faq4" aria-labelledby="faq-h">
          <h2 id="faq-h">Questions procurement teams are asking</h2>
          {d.faqs.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>
      )}

      <div class="filed">
        <span>Filed under</span>
        <a href="/guides/">Guides</a>
        <a href={`/topics/${d.topic}/`}>{topicName}</a>
      </div>
      {d.tags.length > 0 && (
        <div class="tagline">
          <span>Topics in this guide</span>
          {d.tags.map((t) => <a href={`/tags/${slugify(t)}/`}>{t}</a>)}
        </div>
      )}

      <section class="method">
        <h2>How we wrote this guide</h2>
        <p>This guide draws on {d.sources.length} {d.sources.length === 1 ? 'source' : 'sources'}, listed below, and on our own reporting. It was last reviewed on {fmt(d.updated)} and is updated when rules or market conditions change. It is general guidance, not legal or financial advice. See our <a href="/editorial-standards/">editorial standards</a>.</p>
      </section>

      {d.sources.length > 0 && (
        <section class="sources">
          <h2>Sources</h2>
          <ol>{d.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.name}</a></li>)}</ol>
        </section>
      )}

      <AdMesh variant="leader" placement="guide-end" />

      {otherGuides.length > 0 && (
        <section class="readmore4" aria-label="More guides" data-slider>
          <div class="rm-head">
            <h2>More <a href="/guides/">guides and playbooks</a></h2>
            <div class="rm-arrows">
              <button type="button" data-dir="-1" aria-label="Previous guides">‹</button>
              <button type="button" data-dir="1" aria-label="More guides">›</button>
            </div>
          </div>
          <div class="rm-track">
            {otherGuides.map((o) => (
              <a class="gcard" href={`/guides/${o.id}/`}>
                <span class="gcard-k">Guide · {TOPICS[o.data.topic]?.name ?? 'Procurement'}</span>
                <strong>{o.data.title}</strong>
                <span class="gcard-d">{clip(o.data.description, 140)}</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </article>

    <aside class="side side4">
      {toc.length > 0 && (
        <nav class="toc toc4" aria-label="In this guide">
          <h2>In this guide</h2>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <Rail posts={posts} show={['popular', 'software', 'analysis', 'outlook', 'events']} />
      <div class="side-sticky">
        <section class="side-nl">
          <h2>Get the morning brief</h2>
          <p>The procurement stories that matter and what they mean for your categories, every weekday.</p>
          <a class="nl-btn" href="#newsletter">Sign up free</a>
        </section>
        <AdMesh placement="guide-side" />
      </div>
    </aside>
  </div>

  {related.length > 0 && (
    <section class="related4" aria-label="Related news">
      <h2 class="h-rule">Latest on this topic<a class="view-all" href={`/topics/${d.topic}/`}>More in {topicName}</a></h2>
      <div class="rel-grid">{related.map((x) => <Tile item={x} size="md" />)}</div>
    </section>
  )}

  <script is:inline>
    document.querySelectorAll('[data-slider]').forEach((s) => {
      const track = s.querySelector('.rm-track');
      s.querySelectorAll('[data-dir]').forEach((b) => b.addEventListener('click', () => track.scrollBy({ left: Number(b.dataset.dir) * track.clientWidth * 0.8, behavior: 'smooth' })));
    });
    document.querySelectorAll('.copy-link').forEach((b) => b.addEventListener('click', () => {
      navigator.clipboard?.writeText(b.dataset.url).then(() => { b.textContent = 'Link copied'; }, () => {});
    }));
    (() => {
      const links = [...document.querySelectorAll('[data-toc]')];
      if (!links.length) return;
      const map = new Map(links.map((a) => [a.dataset.toc, a]));
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { links.forEach((a) => a.classList.remove('active')); map.get(e.target.id)?.classList.add('active'); } });
      }, { rootMargin: '-20% 0px -70% 0px' });
      map.forEach((_, id) => { const el = document.getElementById(id); if (el) obs.observe(el); });
    })();
  </script>
</Base>

<style>
  .guide-kicker { display: inline-block; font: 600 12.5px/1 var(--ui); color: #fff; background: var(--teal); padding: 5px 8px; margin: 8px 0 2px; }
  .gcard { scroll-snap-align: start; display: flex; flex-direction: column; gap: 8px; background: var(--navy-tint); border-top: 3px solid var(--navy); padding: 16px 16px 18px; text-decoration: none; color: var(--ink); min-height: 190px; }
  .gcard:hover strong { text-decoration: underline; }
  .gcard-k { font: 600 12px var(--ui); color: var(--teal); }
  .gcard strong { font: 700 17px/1.3 var(--head); }
  .gcard-d { font: 14px/1.45 var(--ui); color: var(--ink-2); }
</style>
