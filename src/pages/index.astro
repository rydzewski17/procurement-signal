---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Media from '../components/Media.astro';
import Trending from '../components/Trending.astro';
import BrowseTopics from '../components/BrowseTopics.astro';
import { getPosts } from '../data/posts';
import { SITE, TOPICS } from '../data/site';
import { trackers } from '../data/trackers';
import StatusBadge from '../components/StatusBadge.astro';
import { categories, fmtPct } from '../data/costs';
const movers = [...categories].sort((a, b) => b.m3ann - a.m3ann).slice(0, 5);

const posts = await getPosts();
const cutoff = posts[0] ? posts[0].data.date.valueOf() - 3 * 864e5 : 0;
const pool = posts.slice(0, 30).filter((p) => p.data.date.valueOf() >= cutoff);
const lead = pool.find((p) => p.data.featured) ?? [...pool].sort((a, b) => b.data.signal - a.data.signal)[0];
const rest = posts.filter((p) => p !== lead);
const stack = rest.slice(0, 5);
const analysis = posts.filter((p) => p.data.type !== 'news' && p !== lead).slice(0, 3);
const more = rest.slice(5, 13);
const byTopic = Object.keys(TOPICS)
  .map((t) => ({ t, items: posts.filter((p) => p.data.topic === t && p !== lead).slice(0, 4) }))
  .filter((g) => g.items.length);
const leadWhy = lead?.body?.match(/## Why it matters\s+([\s\S]*?)(\n## |$)/)?.[1]?.trim().split('\n')[0]?.replace(/[*_]/g, '');
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const jsonLd = { '@context': 'https://schema.org', '@type': 'NewsMediaOrganization', name: SITE.name, url: Astro.site?.toString() };
---
<Base jsonLd={jsonLd} section="home">
  {!lead ? <p style="padding:40px 0">The first stories publish shortly.</p> : (
  <>
    <Trending posts={posts} />
    <div class="front">
      <section class="lead" aria-label="Top story">
        <a href={`/articles/${lead.id}/`} tabindex="-1" aria-hidden="true"><Media post={lead} ratio="wide" eager /></a>
        <a class="topic" href={`/topics/${lead.data.topic}/`}>{TOPICS[lead.data.topic].name}</a>
        <a href={`/articles/${lead.id}/`}><h2>{lead.data.title}</h2></a>
        <p class="dek">{lead.data.dek}</p>
        <div class="date">By {lead.data.author}, {fmt(lead.data.date)}</div>
        {leadWhy && <div class="summary"><strong>Why it matters</strong>{leadWhy}</div>}
      </section>
      <section class="stack" aria-label="Latest stories">
        <h2 class="block-head">Latest</h2>
        {stack.map((p) => <Card post={p} size="thumb" />)}
      </section>
      <aside class="rail">
        <div>
          <h2>Cost Pressure Monitor</h2>
          <table class="mini-monitor">
            <tbody>{movers.map((c) => <tr><td><a href={`/cost-monitor/${c.id}/`}>{c.name}</a></td><td class="num">{fmtPct(c.y1)}</td><td class="num"><StatusBadge status={c.status} /></td></tr>)}</tbody>
          </table>
          <p class="meta" style="margin:0 0 6px">Biggest price pressure now. Change over 12 months.</p>
          <a class="more" href="/cost-monitor/">All 12 categories</a>
        </div>
        <div style="margin-top:30px">
          <h2>Trackers</h2>
          <ul class="linklist">
            {trackers.map((t) => <li><a href={`/trackers/${t.slug}/`}>{t.title}</a><span class="date">Updated {t.updated}</span></li>)}
          </ul>
        </div>
        <div class="signup">
          <h3>The morning briefing</h3>
          <p>The procurement stories that matter, in your inbox every weekday. Launching soon; follow by RSS until then.</p>
          <a class="button" href="/rss.xml">Get the RSS feed</a>
        </div>
        {more.length > 0 && (
          <div>
            <h2>More stories</h2>
            <ul class="linklist">{more.map((p) => <li><a href={`/articles/${p.id}/`}>{p.data.title}</a></li>)}</ul>
          </div>
        )}
      </aside>
    </div>

    {analysis.length > 0 && (
      <section class="band" aria-label="Analysis and signal reports">
        <div class="block-head">Analysis and signal reports</div>
        <div class="feature-row">{analysis.map((p) => <Card post={p} size="feature" />)}</div>
      </section>
    )}

    <div class="sections">
      {byTopic.map(({ t, items }) => (
        <section>
          <div class="block-head"><a href={`/topics/${t}/`} class="block-title">{TOPICS[t].name}</a><a href={`/topics/${t}/`}>See all</a></div>
          <Card post={items[0]} size="feature" showTopic={false} />
          {items.slice(1).map((p) => <Card post={p} size="title" />)}
        </section>
      ))}
    </div>

    <BrowseTopics posts={posts} />
  </>
  )}
</Base>
