---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import CategoryWatch from '../components/CategoryWatch.astro';
import SignalMeter from '../components/SignalMeter.astro';
import Kicker from '../components/Kicker.astro';
import Rail from '../components/v4/Rail.astro';
import Tile from '../components/v4/Tile.astro';
import Line from '../components/v4/Line.astro';
import { getPosts } from '../data/posts';
import { SITE, TYPE_LABEL } from '../data/site';
import { SECTIONS, categoryBySlug } from '../data/categories.mjs';
import { ourItems, feedFor, shortDate, whyOf } from '../data/feed';

const posts = await getPosts();
const DAY = 864e5;
const newest = posts[0]?.data.date.valueOf() ?? 0;

// Hero: the featured story, then the top five by signal and freshness.
const lead = posts.find((p) => p.data.featured) ?? posts[0];
const rank = (p: any) => p.data.signal * 2 - (newest - p.data.date.valueOf()) / DAY;
const topStories = posts.filter((p) => p !== lead).sort((a, b) => rank(b) - rank(a)).slice(0, 5);
const shown = new Set<string>([lead, ...topStories].filter(Boolean).map((p) => `/articles/${p.id}/`));

// The latest: our newest stories not already in the hero, with photo, summary and a key number.
const latest = ourItems(posts).filter((x) => !shown.has(x.href)).sort((a, b) => b.t - a.t).slice(0, 8);
latest.forEach((x) => shown.add(x.href));

// Section blocks: a spotlight story plus four more per section. Stories not yet on
// the page come first; a story can appear again under its own section if needed.
const used = new Set<string>();
const blocks = SECTIONS.map((s) => {
  const fresh = feedFor(posts, s.slugs, new Set([...shown, ...used]));
  const again = feedFor(posts, s.slugs).filter((x) => !fresh.some((y) => y.href === x.href) && !used.has(x.href));
  const items = [...fresh, ...again].slice(0, 5);
  items.forEach((x) => used.add(x.href));
  return { s, items };
}).filter((b) => b.items.length >= 3);

const leadWhy = lead ? whyOf(lead) : '';
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const catLabel = (cats: string[]) => categoryBySlug[cats[0]]?.name;
const jsonLd = { '@context': 'https://schema.org', '@type': 'NewsMediaOrganization', name: SITE.name, url: Astro.site?.toString() };
---
<Base jsonLd={jsonLd} section="home">
  {!lead ? <p style="padding:40px 0">The first stories publish shortly.</p> : (
  <>
    <div class="home-grid">
      <div class="home-main">
        <section class="hero4" aria-label="Top stories">
          <div class="hero4-lead">
            <a href={`/articles/${lead.id}/`} tabindex="-1" aria-hidden="true"><Media post={lead} ratio="wide" eager /></a>
            <div class="lead-meta"><Kicker topic={lead.data.topic} /><SignalMeter level={lead.data.signal} /></div>
            <h2><a href={`/articles/${lead.id}/`}>{lead.data.title}</a></h2>
            <p class="dek">{lead.data.dek}</p>
            {leadWhy && <p class="why"><strong>Why it matters.</strong> {leadWhy}</p>}
            <div class="byline-line">By {lead.data.author}, {fmt(lead.data.date)}</div>
          </div>
          <div class="hero4-top">
            <h2 class="h-rule">Top stories</h2>
            <ol class="top5">
              {topStories.map((p) => (
                <li>
                  <div>
                    <Kicker topic={p.data.topic} />
                    <a class="t5-title" href={`/articles/${p.id}/`}>{p.data.title}</a>
                  </div>
                  <a class="t5-thumb" href={`/articles/${p.id}/`} tabindex="-1" aria-hidden="true"><Media post={p} ratio="square" /></a>
                </li>
              ))}
            </ol>
          </div>
        </section>

        <section class="latest4" aria-label="The latest">
          <h2 class="h-rule">The latest<a class="view-all" href="/archive/">All stories</a></h2>
          <div class="latest-list">
            {latest.map((x, i) => (
              <>
                {i === 4 && <div class="ad-slot ad-inline">Advertisement</div>}
                <article class="lrow">
                  <a class="lthumb" href={x.href} tabindex="-1" aria-hidden="true"><Media post={x.post} ratio="card" /></a>
                  <div class="lbody">
                    <div class="lkick"><Kicker topic={x.post.data.topic} />{x.post.data.type !== 'news' && <span class="ltype">{TYPE_LABEL[x.post.data.type]}</span>}</div>
                    <h3><a href={x.href}>{x.title}</a></h3>
                    <p>{x.dek}</p>
                    {x.fact && <p class="lfact"><b>{x.fact.value}</b> {x.fact.label}</p>}
                    <span class="lmeta">{shortDate(x.t)} · {x.mins} min read{catLabel(x.cats) && <> · <a href={`/categories/${x.cats[0]}/`}>{catLabel(x.cats)}</a></>}</span>
                  </div>
                </article>
              </>
            ))}
          </div>
          <a class="more-btn" href="/archive/">More stories</a>
        </section>

        <CategoryWatch posts={posts} />
      </div>

      <Rail posts={posts} exclude={shown} show={['software', 'popular', 'analysis', 'moves', 'guides', 'events', 'ad']} />
    </div>

    <section class="blocks" aria-label="News by section">
      {blocks.map(({ s, items }) => (
        <section class="block">
          <div class="block-top"><h2><a href={`/sections/${s.id}/`}>{s.name}</a></h2><a class="view-all" href={`/sections/${s.id}/`}>View all</a></div>
          <div class="block-body">
            <Tile item={items[0]} size="md" showDek />
            <ul class="lines lines-thumb">{items.slice(1).map((x) => <Line item={x} thumb />)}</ul>
          </div>
        </section>
      ))}
    </section>
  </>
  )}
</Base>
