---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Media from '../components/Media.astro';
import TopSoftware from '../components/TopSoftware.astro';
import OutlookRail from '../components/OutlookRail.astro';
import HouseAd from '../components/HouseAd.astro';
import { getPosts } from '../data/posts';
import { SITE, TOPICS } from '../data/site';
import { trackers } from '../data/trackers';
import { getCollection } from 'astro:content';
import wire from '../data/wire.json';

const posts = await getPosts();
const guides = await getCollection('guides');
const DAY = 864e5;
const newest = posts[0]?.data.date.valueOf() ?? 0;

// Hero: the featured story (or the strongest of the last three days), then the
// top stories ranked by signal and freshness.
const pool = posts.slice(0, 30).filter((p) => p.data.date.valueOf() >= newest - 3 * DAY);
const lead = pool.find((p) => p.data.featured) ?? [...pool].sort((a, b) => b.data.signal - a.data.signal)[0];
const rank = (p: any) => p.data.signal * 2 - (newest - p.data.date.valueOf()) / DAY;
const top = posts.filter((p) => p !== lead).sort((a, b) => rank(b) - rank(a)).slice(0, 5);
const used = new Set([lead, ...top]);
const secondary = posts.filter((p) => !used.has(p)).slice(0, 3);
secondary.forEach((p) => used.add(p));
const latest = posts.filter((p) => !used.has(p)).slice(0, 12);
const analysis = posts.filter((p) => p.data.type !== 'news' && p !== lead).slice(0, 3);

// Category blocks: lead card plus four headlines per topic, two topics per row.
const byTopic = Object.keys(TOPICS)
  .map((t) => ({ t, items: posts.filter((p) => p.data.topic === t && p !== lead).slice(0, 5) }))
  .filter((g) => g.items.length);

const leadWhy = lead?.body?.match(/## Why it matters\s+([\s\S]*?)(\n## |$)/)?.[1]?.trim().split('\n')[0]?.replace(/[*_]/g, '');
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const wireDate = (d: string) => new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
const jsonLd = { '@context': 'https://schema.org', '@type': 'NewsMediaOrganization', name: SITE.name, url: Astro.site?.toString() };
---
<Base jsonLd={jsonLd} section="home">
  {!lead ? <p style="padding:40px 0">The first stories publish shortly.</p> : (
  <>
    <div class="hero">
      <div class="hero-main">
        <section class="lead" aria-label="Top story">
          <a href={`/articles/${lead.id}/`} tabindex="-1" aria-hidden="true"><Media post={lead} ratio="wide" eager /></a>
          <a class="topic" href={`/topics/${lead.data.topic}/`}>{TOPICS[lead.data.topic].name}</a>
          <a href={`/articles/${lead.id}/`}><h2>{lead.data.title}</h2></a>
          <p class="dek">{lead.data.dek}</p>
          <div class="date">By {lead.data.author}, {fmt(lead.data.date)}</div>
          {leadWhy && <div class="summary"><strong>Why it matters</strong>{leadWhy}</div>}
        </section>
        {secondary.length > 0 && (
          <div class="secondary">{secondary.map((p) => <Card post={p} size="feature" />)}</div>
        )}
      </div>
      <aside class="hero-top" aria-label="Top stories">
        <h2 class="block-head">Top stories</h2>
        <ol class="toplist">
          {top.map((p) => (
            <li>
              <div>
                <a class="topic" href={`/topics/${p.data.topic}/`}>{TOPICS[p.data.topic].name}</a>
                <a href={`/articles/${p.id}/`}><h3>{p.data.title}</h3></a>
                <div class="date">{fmt(p.data.date)}</div>
              </div>
            </li>
          ))}
        </ol>
        <HouseAd variant="outlook" />
      </aside>
    </div>

    <div class="main-rail">
      <section class="latest" aria-label="Latest news">
        {latest.length > 0 && (
          <>
            <h2 class="block-head">The latest</h2>
            <div class="river">
              {latest.slice(0, 6).map((p) => <Card post={p} />)}
              {latest.length > 6 && <HouseAd variant="finder" wide />}
              {latest.slice(6).map((p) => <Card post={p} />)}
            </div>
            <a class="button-ghost more-stories" href="/archive/">More stories</a>
          </>
        )}
        {analysis.length > 0 && (
          <section class="band" aria-label="Analysis and signal reports" style={latest.length ? '' : 'margin-top:0;border-top:0;padding-top:0'}>
            <div class="block-head">Analysis and signal reports</div>
            <div class="feature-row two">{analysis.slice(0, 2).map((p) => <Card post={p} size="feature" />)}</div>
          </section>
        )}
        {wire.items.length > 0 && (
          <section class="band" aria-label="What we're reading">
            <div class="block-head"><span>What we're reading</span><a href="/wire/">All headlines</a></div>
            <ul class="wire-list">{wire.items.slice(0, 10).map((w) => <li><a href={w.url} target="_blank" rel="noopener">{w.title}</a><span class="date">{w.source} · {wireDate(w.date)}</span></li>)}</ul>
          </section>
        )}
      </section>

      <aside class="rail" aria-label="More from Procurement Signal">
        <OutlookRail />
        <div class="rail-module">
          <h2>Trackers</h2>
          <ul class="linklist">
            {trackers.map((t) => <li><a href={`/trackers/${t.slug}/`}>{t.title}</a><span class="date">Updated {t.updated}</span></li>)}
          </ul>
        </div>
        <div class="rail-module">
          <h2>Guides and playbooks</h2>
          <ul class="linklist">
            {guides.map((g) => <li><a href={`/guides/${g.id}/`}>{g.data.title}</a></li>)}
          </ul>
          <a class="more" href="/glossary/">Procurement glossary</a>
        </div>
        <HouseAd variant="finder" />
      </aside>
    </div>

    <TopSoftware />

    <div class="sections two-up">
      {byTopic.map(({ t, items }) => (
        <section>
          <div class="block-head"><a href={`/topics/${t}/`} class="block-title">{TOPICS[t].name}</a><a href={`/topics/${t}/`}>View all</a></div>
          <div class="section-split">
            <Card post={items[0]} size="feature" showTopic={false} />
            {items.length > 1 && <div>{items.slice(1).map((p) => <Card post={p} size="title" />)}</div>}
          </div>
        </section>
      ))}
    </div>

    <section class="tools-band" aria-label="Tools">
      <a href="/software/finder/" class="tool-card">
        <span class="topic">Software Finder</span>
        <h3>Get a software shortlist in four questions</h3>
        <p>Matched to your needs, company size, ERP and priorities, from our rankings.</p>
      </a>
      <a href="/outlook/" class="tool-card">
        <span class="topic">Market Outlook</span>
        <h3>Where prices are heading in what you buy</h3>
        <p>Our call on buyer leverage, price direction and supply risk across 12 categories.</p>
      </a>
      <a href="/cost-monitor/" class="tool-card">
        <span class="topic">Cost Pressure Monitor</span>
        <h3>Monthly price data for 12 spend categories</h3>
        <p>Producer price trends with a clear pressure reading for each category.</p>
      </a>
    </section>
  </>
  )}
</Base>
