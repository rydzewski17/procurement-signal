---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { getPosts } from '../data/posts';
import { SITE, TOPICS } from '../data/site';
import { trackers } from '../data/trackers';

const posts = await getPosts();
const cutoff = posts[0] ? posts[0].data.date.valueOf() - 3 * 864e5 : 0;
const pool = posts.slice(0, 30).filter((p) => p.data.date.valueOf() >= cutoff);
const lead = pool.find((p) => p.data.featured) ?? [...pool].sort((a, b) => b.data.signal - a.data.signal)[0];
const rest = posts.filter((p) => p !== lead);
const stack = rest.slice(0, 6);
const more = rest.slice(6, 14);
const byTopic = Object.keys(TOPICS)
  .map((t) => ({ t, items: posts.filter((p) => p.data.topic === t && p !== lead).slice(0, 4) }))
  .filter((g) => g.items.length);
const leadWhy = lead?.body?.match(/## Why it matters\s+([\s\S]*?)(\n## |$)/)?.[1]?.trim().split('\n')[0]?.replace(/[*_]/g, '');
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const jsonLd = { '@context': 'https://schema.org', '@type': 'NewsMediaOrganization', name: SITE.name, url: Astro.site?.toString() };
---
<Base jsonLd={jsonLd} section="home">
  {!lead ? <p style="padding:40px 0">The first stories publish shortly.</p> : (
  <>
    <div class="front">
      <section class="lead" aria-label="Top story">
        <a class="topic" href={`/topics/${lead.data.topic}/`}>{TOPICS[lead.data.topic].name}</a>
        <a href={`/articles/${lead.id}/`}><h2>{lead.data.title}</h2></a>
        <p class="dek">{lead.data.dek}</p>
        <div class="date">By {lead.data.author}, {fmt(lead.data.date)}</div>
        {leadWhy && <div class="summary"><strong>Why it matters</strong>{leadWhy}</div>}
      </section>
      <section class="stack" aria-label="Latest stories">
        {stack.map((p) => <Card post={p} size="stack" />)}
      </section>
      <aside class="rail">
        <div>
          <h2>Trackers</h2>
          <ul class="linklist">
            {trackers.map((t) => <li><a href={`/trackers/${t.slug}/`}>{t.title}</a></li>)}
          </ul>
        </div>
        <div class="signup">
          <h3>The morning briefing</h3>
          <p>The procurement stories that matter, in your inbox every weekday. Launching soon; follow by RSS until then.</p>
          <a class="button" href="/rss.xml">Get the RSS feed</a>
        </div>
        {more.length > 0 && (
          <div>
            <h2>More stories</h2>
            <ul class="linklist">{more.map((p) => <li><a href={`/articles/${p.id}/`}>{p.data.title}</a></li>)}</ul>
          </div>
        )}
      </aside>
    </div>
    <div class="sections">
      {byTopic.map(({ t, items }) => (
        <section>
          <div class="block-head"><a href={`/topics/${t}/`} style="color:var(--brand);font-size:15px;font-weight:700">{TOPICS[t].name}</a><a href={`/topics/${t}/`}>See all</a></div>
          {items.map((p) => <Card post={p} size="title" />)}
        </section>
      ))}
    </div>
  </>
  )}
</Base>
