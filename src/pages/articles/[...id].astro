---
import AdMesh from '../../components/AdMesh.astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Rail from '../../components/v4/Rail.astro';
import Media from '../../components/Media.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import Tile from '../../components/v4/Tile.astro';
import { catsOf, feedFor, ourItems, clip, shortDate } from '../../data/feed';
import { sectionOf, categoryBySlug } from '../../data/categories.mjs';
import { getPosts } from '../../data/posts';
import { slugify } from '../../data/tags';
import { linkVendors } from '../../data/vendorlinks';
import { linkInternal, linkSources } from '../../data/autolinks';
import { SITE, TOPICS, TYPE_LABEL } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post, posts } }));
}
const { post, posts } = Astro.props;
const d = post.data;
const { Content, headings } = await render(post);
const tocItems = headings.filter((h) => h.depth === 2 && h.text.toLowerCase() !== 'why it matters');

// Lift "Why it matters" into the Article summary and split the story so the
// "Read more in" slider sits at the end of the article, after the sources.
const html: string = post.rendered?.html ?? '';
const parts = html.split(/(?=<h2[\s>])/);
const intro = parts[0].startsWith('<h2') ? '' : parts.shift()!;
const headingOf = (x: string) => x.match(/<h2[^>]*>([\s\S]*?)<\/h2>/)?.[1]?.replace(/<[^>]+>/g, '').trim().toLowerCase() ?? '';
const textOf = (x: string) => x.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const whyIdx = parts.findIndex((x) => headingOf(x) === 'why it matters');
const why = whyIdx >= 0 ? textOf(parts[whyIdx].replace(/<h2[\s\S]*?<\/h2>/, '')) : '';
if (whyIdx >= 0) parts.splice(whyIdx, 1);
const doIdx = parts.findIndex((x) => /^what (buyers|procurement teams) should do/.test(headingOf(x)));
const actions = doIdx >= 0 ? [...parts[doIdx].matchAll(/<li>([\s\S]*?)<\/li>/g)].map((m) => textOf(m[1])).slice(0, 2) : [];
if (doIdx >= 0) parts[doIdx] = parts[doIdx].replace('<h2', '<h2 class="do-head"').replace(/<ul>/, '<ul class="do-list">');
const cut = Math.min(2, parts.length);
const linked = new Set<string>();
const before = linkVendors(intro + parts.slice(0, cut).join(''), linked);
const after = linkVendors(parts.slice(cut).join(''), linked);

// Category and section for the breadcrumb and the slider.
const cats = catsOf(post).filter((c) => categoryBySlug[c]);
const primary = cats[0];
const sec = sectionOf(cats);
const self = `/articles/${post.id}/`;
const slider = primary ? feedFor(posts, [primary], new Set([self]), true).slice(0, 6) : [];
const words = post.body ? post.body.split(/\s+/).length : 0;
const mins = Math.max(1, Math.round(words / 230));
const idx = posts.findIndex((p) => p.id === post.id);
const newer = idx > 0 ? posts[idx - 1] : null;
const older = idx >= 0 && idx < posts.length - 1 ? posts[idx + 1] : null;
const fmt = (x: Date) => x.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

// Read next: score other stories by shared tags, same topic and recency.
const myTags = new Set(d.tags.map(slugify));
const scored = posts.filter((p) => p.id !== post.id).map((p) => ({
  p, s: p.data.tags.filter((t) => myTags.has(slugify(t))).length * 3 + (p.data.topic === d.topic ? 2 : 0) + p.data.signal / 5,
})).sort((a, b) => b.s - a.s);
const readNext = scored.slice(0, 6).map((x) => x.p);
// Related: our closest stories by tags, topic and category, not already in the slider.
const relatedSeen = new Set([self, ...slider.map((x) => x.href)]);
const related = ourItems(scored.map((x) => x.p)).filter((x) => !relatedSeen.has(x.href)).slice(0, 6);
// Top 10 this week: our stories ranked by signal and freshness.
const DAY = 864e5;
const newestT = posts[0]?.data.date.valueOf() ?? 0;
const ranked = posts.filter((p) => p.id !== post.id).sort((a, b) => (b.data.signal * 2 - (newestT - b.data.date.valueOf()) / DAY) - (a.data.signal * 2 - (newestT - a.data.date.valueOf()) / DAY));
const top10 = ourItems(ranked).slice(0, 10);

const url = new URL(`/articles/${post.id}/`, Astro.site).toString();
const enc = encodeURIComponent;
const site = Astro.site?.toString() ?? '/';
const imageUrl = d.image?.src ? `${d.image.src}${d.image.src.includes('?') ? '&' : '?'}w=1600&q=80` : undefined;
const graph: any[] = [
  {
    '@type': 'NewsArticle', headline: d.title, description: d.dek, image: imageUrl ? [imageUrl] : undefined,
    datePublished: d.date.toISOString(), dateModified: (d.updated ?? d.date).toISOString(),
    author: { '@type': 'Organization', name: d.author, url: new URL('/about/', site).toString() },
    publisher: { '@type': 'NewsMediaOrganization', name: SITE.name, url: site },
    mainEntityOfPage: url, articleSection: sec.name, keywords: d.tags.join(', '), wordCount: words,
    about: cats.map((c) => ({ '@type': 'Thing', name: categoryBySlug[c].name })),
    citation: d.sources.map((x: any) => ({ '@type': 'CreativeWork', name: x.name, url: x.url })),
  },
  {
    '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site },
      { '@type': 'ListItem', position: 2, name: sec.name, item: new URL(`/sections/${sec.id}/`, site).toString() },
      ...(primary ? [{ '@type': 'ListItem', position: 3, name: categoryBySlug[primary].name, item: new URL(`/categories/${primary}/`, site).toString() }] : []),
    ],
  },
];
if (d.faqs?.length) graph.push({ '@type': 'FAQPage', mainEntity: d.faqs.map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---
import AdMesh from '../../components/AdMesh.astro';
<Base title={d.title} description={d.dek} type="article" jsonLd={jsonLd} section={d.topic}>
  <div class="article-layout">
    <article class="article" data-pagefind-body>
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href={`/sections/${sec.id}/`}>{sec.name}</a>{primary && <> / <a href={`/categories/${primary}/`}>{categoryBySlug[primary].name}</a></>}{d.type !== 'news' && <> / {TYPE_LABEL[d.type]}</>}</nav>
      <h1>{d.title}</h1>
      <p class="dek">{d.dek}</p>
      <div class="byline">
        <div>
          <div class="who">By {d.author}</div>
          <div class="when">Published {fmt(d.date)}{d.updated && <>. Updated {fmt(d.updated)}</>}</div>
          <div class="read-meta">{mins} min read · Signal {d.signal}/5</div>
        </div>
        <div class="share">
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`} target="_blank" rel="noopener">LinkedIn</a>
          <a href={`https://x.com/intent/post?url=${enc(url)}&text=${enc(d.title)}`} target="_blank" rel="noopener">X</a>
          <a href={`mailto:?subject=${enc(d.title)}&body=${enc(url)}`}>Email</a>
          <button type="button" class="copy-link" data-url={url}>Copy link</button>
        </div>
      </div>
      <Media post={post} ratio="wide" caption eager />
      {(why || actions.length > 0) && (
        <section class="art-summary" aria-label="Article summary">
          <h2>Article summary</h2>
          <ul>
            {why && <li><strong>Why it matters:</strong> {why}</li>}
            {actions.map((a, i) => <li>{i === 0 && <strong>What to do first: </strong>}{a}</li>)}
          </ul>
        </section>
      )}
      <KeyFacts facts={d.keyfacts} />
      {tocItems.length > 0 && (
        <details class="toc-mobile">
          <summary>On this page</summary>
          <ol>{tocItems.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </details>
      )}
      <div class="prose" set:html={linkSources(linkInternal(before + after, `/articles/${post.id}/`), d.sources)} />

      {d.faqs?.length > 0 && (
        <section class="faq4" aria-labelledby="faq-h">
          <h2 id="faq-h">Questions procurement teams are asking</h2>
          {d.faqs.map((f: any, i: number) => (
            <details open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>
      )}

      {cats.length > 0 && (
        <div class="filed">
          <span>Filed under</span>
          {cats.map((c) => <a href={`/categories/${c}/`}>{categoryBySlug[c].name}</a>)}
        </div>
      )}

      {d.tags.length > 0 && (
        <div class="tagline">
          <span>Topics in this story</span>
          {d.tags.map((t) => <a href={`/tags/${slugify(t)}/`}>{t}</a>)}
        </div>
      )}

      {(newer || older) && (
        <nav class="next-prev" aria-label="More stories">
          {older ? <a href={`/articles/${older.id}/`}><span>Previous story</span><strong>{older.data.title}</strong></a> : <span />}
          {newer ? <a href={`/articles/${newer.id}/`}><span>Next story</span><strong>{newer.data.title}</strong></a> : <span />}
        </nav>
      )}

      <section class="method">
        <h2>How we reported this</h2>
        <p>This {d.type === 'news' ? 'story' : TYPE_LABEL[d.type].toLowerCase()} draws on {d.sources.length} {d.sources.length === 1 ? 'source' : 'sources'}, listed below, and reflects figures as reported on {fmt(d.date)}. The sections on why it matters and what procurement teams should do are Procurement Signal analysis. It is not legal or financial advice. See our <a href="/editorial-standards/">editorial standards</a>.</p>
      </section>

      <section class="sources">
        <h2>Sources</h2>
        <ol>{d.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.name}</a></li>)}</ol>
      </section>

      <AdMesh variant="leader" placement="article-end" />

      {slider.length > 1 && primary && (
        <section class="readmore4" aria-label={`Read more in ${categoryBySlug[primary].name}`} data-slider>
          <div class="rm-head">
            <h2>Read more in <a href={`/categories/${primary}/`}>{categoryBySlug[primary].name}</a></h2>
            <div class="rm-arrows">
              <button type="button" data-dir="-1" aria-label="Previous stories">‹</button>
              <button type="button" data-dir="1" aria-label="More stories">›</button>
            </div>
          </div>
          <div class="rm-track">{slider.map((x) => <Tile item={x} size="md" />)}</div>
        </section>
      )}
    </article>

    <aside class="side side4">
      {tocItems.length > 0 && (
        <nav class="toc toc4" aria-label="On this page">
          <h2>On this page</h2>
          <ol>{tocItems.map((h) => <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <Rail posts={posts.filter((p) => p.id !== post.id)} show={['popular', 'software', 'analysis', 'guides', 'outlook', 'events']} exclude={new Set([self])} />
      <div class="side-sticky">
        <section class="side-nl">
          <h2>Get the morning brief</h2>
          <p>The procurement stories that matter and what they mean for your categories, every weekday.</p>
          <a class="nl-btn" href="#newsletter">Sign up free</a>
        </section>
        <AdMesh placement="article-side" />
      </div>
    </aside>
  </div>

  <script is:inline>
    document.querySelectorAll('[data-slider]').forEach((s) => {
      const track = s.querySelector('.rm-track');
      s.querySelectorAll('[data-dir]').forEach((b) => b.addEventListener('click', () => track.scrollBy({ left: Number(b.dataset.dir) * track.clientWidth * 0.8, behavior: 'smooth' })));
    });
    document.querySelectorAll('.copy-link').forEach((b) => b.addEventListener('click', () => {
      navigator.clipboard?.writeText(b.dataset.url).then(() => { b.textContent = 'Link copied'; }, () => {});
    }));
    (() => {
      const links = [...document.querySelectorAll('[data-toc]')];
      if (!links.length) return;
      const map = new Map(links.map((a) => [a.dataset.toc, a]));
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            links.forEach((a) => a.classList.remove('active'));
            map.get(e.target.id)?.classList.add('active');
          }
        });
      }, { rootMargin: '-20% 0px -70% 0px' });
      map.forEach((_, id) => { const el = document.getElementById(id); if (el) obs.observe(el); });
    })();
  </script>

  {top10.length > 0 && (
    <section class="top10-4" aria-label="Top 10 this week">
      <h2 class="h-rule">Top 10 this week</h2>
      <ol>
        {top10.map((x) => (
          <li>
            <a href={x.href}>{clip(x.title, 120)}</a>
            <span>{categoryBySlug[x.cats[0]]?.name ?? 'Procurement Signal'}, {shortDate(x.t)}</span>
          </li>
        ))}
      </ol>
    </section>
  )}
  {related.length > 0 && (
    <section class="related4" aria-label="Related news">
      <h2 class="h-rule">Related news{primary && <a class="view-all" href={`/categories/${primary}/`}>More in {categoryBySlug[primary].name}</a>}</h2>
      <div class="rel-grid">{related.map((x) => <Tile item={x} size="md" />)}</div>
    </section>
  )}

</Base>
