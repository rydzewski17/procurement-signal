---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Media from '../../components/Media.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import Subscribe from '../../components/Subscribe.astro';
import Trending from '../../components/Trending.astro';
import BrowseTopics from '../../components/BrowseTopics.astro';
import { getPosts } from '../../data/posts';
import { slugify } from '../../data/tags';
import { trackers } from '../../data/trackers';
import { SITE, TOPICS, TYPE_LABEL } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post, posts } }));
}
const { post, posts } = Astro.props;
const d = post.data;
const { Content, headings } = await render(post);
const tocItems = headings.filter((h) => h.depth === 2);
const words = post.body ? post.body.split(/\s+/).length : 0;
const mins = Math.max(1, Math.round(words / 230));
const idx = posts.findIndex((p) => p.id === post.id);
const newer = idx > 0 ? posts[idx - 1] : null;
const older = idx >= 0 && idx < posts.length - 1 ? posts[idx + 1] : null;
const fmt = (x: Date) => x.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

// Read next: score other stories by shared tags, same topic and recency.
const myTags = new Set(d.tags.map(slugify));
const scored = posts.filter((p) => p.id !== post.id).map((p) => ({
  p, s: p.data.tags.filter((t) => myTags.has(slugify(t))).length * 3 + (p.data.topic === d.topic ? 2 : 0) + p.data.signal / 5,
})).sort((a, b) => b.s - a.s);
const readNext = scored.slice(0, 3).map((x) => x.p);
const latest = posts.filter((p) => p.id !== post.id && !readNext.includes(p)).slice(0, 5);

const url = new URL(`/articles/${post.id}/`, Astro.site).toString();
const enc = encodeURIComponent;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'NewsArticle', headline: d.title, description: d.dek,
  datePublished: d.date.toISOString(), dateModified: (d.updated ?? d.date).toISOString(),
  author: { '@type': 'Organization', name: d.author }, publisher: { '@type': 'Organization', name: SITE.name },
  mainEntityOfPage: url, articleSection: TOPICS[d.topic].name, keywords: d.tags.join(', '),
};
---
<Base title={d.title} description={d.dek} type="article" jsonLd={jsonLd} section={d.topic}>
  <div class="article-layout">
    <article class="article">
      <div class="crumbs"><a href={`/topics/${d.topic}/`}>{TOPICS[d.topic].name}</a>{d.type !== 'news' && <>&ensp;/&ensp;{TYPE_LABEL[d.type]}</>}</div>
      <h1>{d.title}</h1>
      <p class="dek">{d.dek}</p>
      <div class="byline">
        <div>
          <div class="who">By {d.author}</div>
          <div class="when">Published {fmt(d.date)}{d.updated && <>. Updated {fmt(d.updated)}</>}</div>
          <div class="read-meta">{mins} min read · Signal {d.signal}/5</div>
        </div>
        <div class="share">
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`} target="_blank" rel="noopener">Share on LinkedIn</a>
          <a href={`mailto:?subject=${enc(d.title)}&body=${enc(url)}`}>Email</a>
        </div>
      </div>
      <Media post={post} ratio="wide" caption eager />
      <KeyFacts facts={d.keyfacts} />
      {tocItems.length > 0 && (
        <details class="toc-mobile">
          <summary>On this page</summary>
          <ol>{tocItems.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </details>
      )}
      <div class="prose"><Content /></div>

      {d.tags.length > 0 && (
        <div class="tagline">
          <span>Topics in this story</span>
          {d.tags.map((t) => <a href={`/tags/${slugify(t)}/`}>{t}</a>)}
        </div>
      )}

      {(newer || older) && (
        <nav class="next-prev" aria-label="More stories">
          {older ? <a href={`/articles/${older.id}/`}><span>Previous story</span><strong>{older.data.title}</strong></a> : <span />}
          {newer ? <a href={`/articles/${newer.id}/`}><span>Next story</span><strong>{newer.data.title}</strong></a> : <span />}
        </nav>
      )}

      <Subscribe />

      <section class="sources">
        <h2>Sources</h2>
        <ol>{d.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.name}</a></li>)}</ol>
      </section>
    </article>

    <aside class="side">
      <div class="sticky">
        {tocItems.length > 0 && (
          <nav class="toc" aria-label="On this page">
            <h2>On this page</h2>
            <ol>{tocItems.map((h) => <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>)}</ol>
          </nav>
        )}
        {latest.length > 0 && <h2 class="block-head">Latest headlines</h2>}
        {latest.map((p) => <Card post={p} size="thumb" />)}
        <h2 class="block-head" style="margin-top:28px">Trackers</h2>
        <ul class="linklist">{trackers.map((t) => <li><a href={`/trackers/${t.slug}/`}>{t.title}</a></li>)}</ul>
      </div>
    </aside>
  </div>

  <script is:inline>
    (() => {
      const links = [...document.querySelectorAll('[data-toc]')];
      if (!links.length) return;
      const map = new Map(links.map((a) => [a.dataset.toc, a]));
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            links.forEach((a) => a.classList.remove('active'));
            map.get(e.target.id)?.classList.add('active');
          }
        });
      }, { rootMargin: '-20% 0px -70% 0px' });
      map.forEach((_, id) => { const el = document.getElementById(id); if (el) obs.observe(el); });
    })();
  </script>

  {readNext.length > 0 && (
    <section class="band" aria-label="Read next">
      <div class="block-head">Read next</div>
      <div class="feature-row">{readNext.map((p) => <Card post={p} size="feature" />)}</div>
    </section>
  )}
  <Trending posts={posts} />
  <BrowseTopics posts={posts} current={d.topic} />
</Base>
