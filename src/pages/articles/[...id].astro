---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Media from '../../components/Media.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import { getPosts } from '../../data/posts';
import { slugify } from '../../data/tags';
import { trackers } from '../../data/trackers';
import { SITE, TOPICS, TYPE_LABEL } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post, posts } }));
}
const { post, posts } = Astro.props;
const d = post.data;
const fmt = (x: Date) => x.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const DAY = 864e5;

// Split the rendered story into sections at each H2 so we can lift "Why it
// matters" into the summary box and place the topic slider mid-article.
const html: string = post.rendered?.html ?? '';
const parts = html.split(/(?=<h2[\s>])/);
const intro = parts[0].startsWith('<h2') ? '' : parts.shift()!;
const heading = (s: string) => s.match(/<h2[^>]*>([\s\S]*?)<\/h2>/)?.[1]?.replace(/<[^>]+>/g, '').trim().toLowerCase() ?? '';
const textOf = (s: string) => s.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const whyIdx = parts.findIndex((s) => heading(s) === 'why it matters');
const why = whyIdx >= 0 ? textOf(parts[whyIdx].replace(/<h2[\s\S]*?<\/h2>/, '')) : '';
if (whyIdx >= 0) parts.splice(whyIdx, 1);
const doIdx = parts.findIndex((s) => heading(s).startsWith('what buyers should do'));
const actions = doIdx >= 0 ? [...parts[doIdx].matchAll(/<li>([\s\S]*?)<\/li>/g)].map((m) => textOf(m[1])).slice(0, 2) : [];
const sliderAt = Math.min(2, parts.length);
const before = intro + parts.slice(0, sliderAt).join('');
const after = parts.slice(sliderAt).join('');
const words = textOf(html).split(' ').length;
const minutes = Math.max(1, Math.round(words / 230));

// Mid-article slider: more from this topic, topped up with related stories.
const myTags = new Set(d.tags.map(slugify));
const scored = posts.filter((p) => p.id !== post.id).map((p) => ({
  p, s: p.data.tags.filter((t) => myTags.has(slugify(t))).length * 3 + (p.data.topic === d.topic ? 2 : 0) + p.data.signal / 5,
})).sort((a, b) => b.s - a.s);
const sameTopic = posts.filter((p) => p.id !== post.id && p.data.topic === d.topic).slice(0, 6);
const slider = [...sameTopic, ...scored.map((x) => x.p).filter((p) => !sameTopic.includes(p))].slice(0, 6);
const readNext = scored.map((x) => x.p).filter((p) => !slider.slice(0, 3).includes(p)).slice(0, 3);
const related = readNext.length ? readNext : scored.slice(0, 3).map((x) => x.p);
const newest = posts[0]?.data.date.valueOf() ?? 0;
const top10 = posts.filter((p) => p.id !== post.id)
  .sort((a, b) => (b.data.signal * 2 - (newest - b.data.date.valueOf()) / DAY) - (a.data.signal * 2 - (newest - a.data.date.valueOf()) / DAY))
  .slice(0, 10);
const latest = posts.filter((p) => p.id !== post.id).slice(0, 5);

const url = new URL(`/articles/${post.id}/`, Astro.site).toString();
const enc = encodeURIComponent;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'NewsArticle', headline: d.title, description: d.dek,
    datePublished: d.date.toISOString(), dateModified: (d.updated ?? d.date).toISOString(),
    author: { '@type': 'Organization', name: d.author }, publisher: { '@type': 'Organization', name: SITE.name },
    mainEntityOfPage: url, articleSection: TOPICS[d.topic].name, keywords: d.tags.join(', '),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: TOPICS[d.topic].name, item: new URL(`/topics/${d.topic}/`, Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---
<Base title={d.title} description={d.dek} type="article" jsonLd={jsonLd} section={d.topic}>
  <div class="article-layout">
    <article class="article">
      <div class="crumbs"><a href="/">Home</a>&ensp;/&ensp;<a href={`/topics/${d.topic}/`}>{TOPICS[d.topic].name}</a>{d.type !== 'news' && <>&ensp;/&ensp;{TYPE_LABEL[d.type]}</>}</div>
      <h1>{d.title}</h1>
      <p class="dek">{d.dek}</p>
      <div class="byline">
        <div>
          <div class="who">By {d.author}</div>
          <div class="when">Published {fmt(d.date)}{d.updated && <>. Updated {fmt(d.updated)}</>} · {minutes} min read</div>
        </div>
        <div class="share">
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`} target="_blank" rel="noopener">LinkedIn</a>
          <a href={`https://x.com/intent/post?url=${enc(url)}&text=${enc(d.title)}`} target="_blank" rel="noopener">X</a>
          <a href={`mailto:?subject=${enc(d.title)}&body=${enc(url)}`}>Email</a>
          <button type="button" class="copy-link" data-url={url}>Copy link</button>
        </div>
      </div>
      <Media post={post} ratio="wide" caption eager />

      {(why || actions.length > 0) && (
        <section class="summary-box" aria-label="Article summary">
          <h2>Article summary</h2>
          <ul>
            {why && <li><strong>Why it matters:</strong> {why}</li>}
            {actions.map((a, i) => <li>{i === 0 && <strong>What to do first: </strong>}{a}</li>)}
          </ul>
        </section>
      )}
      <KeyFacts facts={d.keyfacts} />

      <div class="prose" set:html={before} />

      {slider.length > 1 && (
        <section class="readmore" aria-label={`Read more in ${TOPICS[d.topic].name}`} data-slider>
          <div class="readmore-head">
            <h2>Read more in <a href={`/topics/${d.topic}/`}>{TOPICS[d.topic].name}</a></h2>
            <div>
              <button type="button" class="lb-arrow" data-dir="-1" aria-label="Previous stories">‹</button>
              <button type="button" class="lb-arrow" data-dir="1" aria-label="More stories">›</button>
            </div>
          </div>
          <div class="readmore-track">
            {slider.map((p) => <Card post={p} size="feature" showTopic={p.data.topic !== d.topic} />)}
          </div>
        </section>
      )}

      <div class="prose" set:html={after} />

      {d.tags.length > 0 && (
        <div class="tagline">
          <span>Topics in this story</span>
          {d.tags.map((t) => <a href={`/tags/${slugify(t)}/`}>{t}</a>)}
        </div>
      )}

      <section class="sources">
        <h2>Sources</h2>
        <ol>{d.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.name}</a></li>)}</ol>
      </section>
    </article>

    <aside class="side">
      <div class="sticky">
        <h2 class="block-head">Latest headlines</h2>
        {latest.map((p) => <Card post={p} size="thumb" />)}
        <h2 class="block-head" style="margin-top:28px">Trackers</h2>
        <ul class="linklist">{trackers.map((t) => <li><a href={`/trackers/${t.slug}/`}>{t.title}</a></li>)}</ul>
      </div>
    </aside>
  </div>

  {related.length > 0 && (
    <section class="band" aria-label="Related stories">
      <div class="block-head"><span>Related stories</span><a href={`/topics/${d.topic}/`}>More in {TOPICS[d.topic].name}</a></div>
      <div class="feature-row">{related.map((p) => <Card post={p} size="feature" />)}</div>
    </section>
  )}

  {top10.length > 0 && (
    <section class="band" aria-label="Top stories">
      <div class="block-head">Top stories on Procurement Signal</div>
      <ol class="top10">
        {top10.map((p) => <li><a href={`/articles/${p.id}/`}>{p.data.title}</a><span class="date">{TOPICS[p.data.topic].name}</span></li>)}
      </ol>
    </section>
  )}

  <script is:inline>
    document.querySelectorAll('[data-slider]').forEach((s) => {
      const track = s.querySelector('.readmore-track');
      s.querySelectorAll('[data-dir]').forEach((b) => b.addEventListener('click', () => track.scrollBy({ left: Number(b.dataset.dir) * track.clientWidth * 0.8, behavior: 'smooth' })));
    });
    document.querySelectorAll('.copy-link').forEach((b) => b.addEventListener('click', () => {
      navigator.clipboard?.writeText(b.dataset.url).then(() => { b.textContent = 'Link copied'; }, () => {});
    }));
  </script>
</Base>
