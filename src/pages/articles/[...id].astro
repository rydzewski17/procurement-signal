---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import SignalDots from '../../components/SignalDots.astro';
import { getPosts } from '../../data/posts';
import { SITE, TOPICS, TYPE_LABEL } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post, posts } }));
}
const { post, posts } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const fmt = (x: Date) => x.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const related = posts.filter((p) => p.id !== post.id && p.data.topic === d.topic).slice(0, 4);
const url = new URL(`/articles/${post.id}/`, Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'NewsArticle', headline: d.title, description: d.dek,
  datePublished: d.date.toISOString(), dateModified: (d.updated ?? d.date).toISOString(),
  author: { '@type': 'Organization', name: d.author }, publisher: { '@type': 'Organization', name: SITE.name },
  mainEntityOfPage: url, articleSection: TOPICS[d.topic].name, keywords: d.tags.join(', '),
};
---
<Base title={d.title} description={d.dek} type="article" jsonLd={jsonLd}>
  <article class="article">
    <div class="kicker"><a href={`/topics/${d.topic}/`}>{TOPICS[d.topic].name}</a> · {TYPE_LABEL[d.type]}</div>
    <h1>{d.title}</h1>
    <p class="dek">{d.dek}</p>
    <div class="byline">
      <span>By <strong>{d.author}</strong></span>
      <span>{fmt(d.date)}</span>
      {d.updated && <span>Updated {fmt(d.updated)}</span>}
      <span>Signal <SignalDots level={d.signal} /></span>
    </div>
    <div class="prose"><Content /></div>
    <section class="sources">
      <h3>Sources</h3>
      <ol>{d.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.name}</a></li>)}</ol>
    </section>
    {d.tags.length > 0 && <div class="tags">{d.tags.map((t) => <span class="tag">{t}</span>)}</div>}
    {related.length > 0 && (
      <>
        <div class="section-title">More in {TOPICS[d.topic].name}</div>
        {related.map((p) => <Card post={p} />)}
      </>
    )}
  </article>
</Base>
