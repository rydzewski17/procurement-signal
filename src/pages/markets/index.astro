---
import Base from '../../layouts/Base.astro';
import data from '../../data/markets.json';
const fmtVol = (n: number) => n >= 1e6 ? `$${(n / 1e6).toFixed(1)}M` : n >= 1e3 ? `$${Math.round(n / 1e3)}K` : `$${n}`;
const fmtDate = (s: string) => new Date(s + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base title="Prediction market odds for procurement" description="Prediction-market odds on tariffs, trade, rates, freight and commodities, explained for procurement." section="markets">
  <div class="page">
    <div class="page-head">
      <h1>Prediction market odds</h1>
      <p>What traders think will happen on the policy and price questions that drive your costs. Odds are crowd expectations from prediction markets, not forecasts or advice.</p>
    </div>

    {data.markets.length === 0 ? (
      <div class="empty card">
        <strong>Market odds load with the next daily update.</strong>
        <p>We track open markets on tariffs, trade policy, interest rates, freight and metals, and refresh them every morning.</p>
      </div>
    ) : (
      <>
        <p class="stamp">Updated {fmtDate(data.updated!)} · Source: Polymarket</p>
        <ul class="mkts">
          {data.markets.map((m) => (
            <li class="mkt card">
              <a class="q" href={m.url} target="_blank" rel="noopener">{m.question}</a>
              <div class="odds">
                <div class="yes"><span class="pct">{m.yes}%</span><span class="lbl">Yes</span></div>
                <div class="bar" aria-hidden="true"><span style={`width:${m.yes}%`}></span></div>
              </div>
              <div class="foot">
                <span>{fmtVol(m.volume24h)} traded in 24h</span>
                {m.change24h !== null && <span class={m.change24h >= 0 ? 'up' : 'down'}>{m.change24h >= 0 ? '▲' : '▼'} {Math.abs(m.change24h)} pts today</span>}
                {m.endDate && <span>Resolves {fmtDate(m.endDate)}</span>}
              </div>
            </li>
          ))}
        </ul>
      </>
    )}

    <section id="how-to-read" class="how">
      <h2>How to read these odds</h2>
      <p>Each market is a question with a Yes price between 0% and 100%. A price of 30% means traders put about a one-in-three chance on Yes. Prices move as news arrives, and thin markets can swing on small trades, so check the volume before you act.</p>
      <p>Use the odds as one input next to the official notice, your supplier data and your contract terms.</p>
    </section>

    <p class="disclaimer">Prediction-market prices are a rough gauge of expectations and can move on thin volume. Use them as one input alongside the official notice and your supplier data.</p>
  </div>
</Base>

<style>
  .card { background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius); box-shadow: var(--shadow); }
  .empty { padding: 26px 28px; margin-top: 12px; }
  .empty strong { font-size: 17px; }
  .empty p { color: var(--ink-2); margin: 8px 0 0; }
  .stamp { font-size: 13px; color: var(--muted); margin: 14px 0; }
  .mkts { list-style: none; padding: 0; margin: 14px 0 0; display: grid; gap: 14px; }
  .mkt { padding: 20px 22px; }
  .q { font-weight: 600; font-size: 17px; line-height: 1.35; color: var(--ink); }
  .q:hover { text-decoration: underline; }
  .odds { display: flex; align-items: center; gap: 16px; margin: 14px 0 10px; }
  .yes { display: flex; align-items: baseline; gap: 6px; min-width: 110px; }
  .pct { font: 700 28px/1 var(--sans); color: var(--ink); font-variant-numeric: tabular-nums; }
  .lbl { font-size: 13px; color: var(--muted); }
  .bar { flex: 1; height: 8px; background: var(--band); border-radius: 999px; overflow: hidden; }
  .bar span { display: block; height: 100%; background: var(--accent); }
  .foot { display: flex; flex-wrap: wrap; gap: 16px; font-size: 13px; color: var(--muted); }
  .up { color: var(--hot); } .down { color: var(--cool); }
  .how { margin: 40px 0 0; max-width: 680px; }
  .how h2 { font: 800 22px/1.25 var(--sans); margin: 0 0 10px; }
  .how p { font-size: 16px; color: var(--ink-2); }
  .disclaimer { font-size: 13px; color: var(--muted); margin: 32px 0 40px; max-width: 680px; }
</style>
