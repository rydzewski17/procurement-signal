---
import Base from '../../layouts/Base.astro';
import { trackers } from '../../data/trackers';
export function getStaticPaths() {
  return trackers.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props;
---
<Base title={t.title} description={t.description} section="trackers">
  <div class="page">
    <div class="page-head narrow">
      <div class="crumbs"><a href="/trackers/">Trackers</a>&ensp;/&ensp;Updated {t.updated}</div>
      <h1>{t.title}</h1>
      <p>{t.intro}</p>
    </div>
    <div class="prose" style="font-size:15px">
      <table>
        <thead><tr>{t.columns.map((c) => <th>{c}</th>)}<th>Source</th></tr></thead>
        <tbody>
          {t.rows.map((r) => (
            <tr>{r.cells.map((c) => <td>{c}</td>)}<td>{r.source ? <a href={r.source} target="_blank" rel="noopener">Link</a> : '—'}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="meta">Spot an error or a missing entry? Trackers are reviewed with every newsroom run.</p>
  </div>
</Base>
