---
import Base from '../../layouts/Base.astro';
import { trackers } from '../../data/trackers';
---
<Base section="trackers" title="Tariff deadlines and trackers" description="Always-current trackers for tariffs, procurement technology deals, commodities and compliance deadlines.">
  <div class="page narrow">
    <div class="page-head">
      <h1>Deadlines and trackers</h1>
      <p>Living reference pages our newsroom keeps current. Bookmark them.</p>
    </div>
    <div class="river">{trackers.map((t) => (
      <article>
        <a href={`/trackers/${t.slug}/`}><h2>{t.title}</h2></a>
        <p>{t.description}</p>
        <div class="date">Updated {t.updated}</div>
      </article>
    ))}</div>
  </div>
</Base>
