---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { slugify } from '../data/tags';
const entries = (await getCollection('glossary')).sort((a, b) => a.data.term.localeCompare(b.data.term));
const rendered = await Promise.all(entries.map(async (e) => ({ e, Content: (await render(e)).Content })));
const letters = [...new Set(entries.map((e) => e.data.term[0].toUpperCase()))];
const url = new URL('/glossary/', Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'DefinedTermSet', name: 'Procurement Signal procurement and supply chain glossary', url,
  hasDefinedTerm: entries.map((e) => ({ '@type': 'DefinedTerm', name: e.data.term, description: e.data.short, url: `${url}#${slugify(e.data.term)}` })),
};
---
<Base title="Procurement and supply chain glossary" description="Plain-English definitions of procurement, sourcing, trade and supply chain terms, from Incoterms to Section 301." jsonLd={jsonLd} section="guides">
  <div class="page narrow">
    <div class="page-head">
      <div class="crumbs"><a href="/guides/">Guides</a></div>
      <h1>Procurement glossary</h1>
      <p>Plain-English definitions of the terms procurement and supply chain teams use every day.</p>
    </div>
    <nav class="letters" aria-label="Jump to letter">{letters.map((l) => <a href={`#letter-${l}`}>{l}</a>)}</nav>
    {letters.map((l) => (
      <section id={`letter-${l}`}>
        <div class="month">{l}</div>
        {rendered.filter(({ e }) => e.data.term[0].toUpperCase() === l).map(({ e, Content }) => (
          <div class="term" id={slugify(e.data.term)}>
            <h2>{e.data.term}</h2>
            <p class="term-short">{e.data.short}</p>
            <div class="prose-page"><Content /></div>
            {e.data.related.length > 0 && <p class="meta">Related: {e.data.related.map((r, i) => <>{i > 0 && ', '}<a href={`#${slugify(r)}`} style="color:var(--link)">{r}</a></>)}</p>}
          </div>
        ))}
      </section>
    ))}
  </div>
</Base>
