---
import Base from '../../layouts/Base.astro';
import Subscribe from '../../components/Subscribe.astro';
import FollowButton from '../../components/FollowButton.astro';
import { SOFTWARE, allCategories, rankG2, rankTeam, teamAverage, fmtDate, slugify, mixOf, g2Tiers, quickPicks, headToHead, TIE, type Vendor } from '../../data/software';

export function getStaticPaths() {
  return allCategories().map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const sw = c.name.replace(/ software$/i, '');
const g2 = rankG2(c);
const team = rankTeam(c);
const tiers = g2Tiers(c);
const picks = quickPicks(c);
const pairs = headToHead(c);
const url = new URL(`/software/${c.slug}/`, Astro.site).toString();
const year = new Date(SOFTWARE.updated + 'T00:00:00Z').getUTCFullYear();
const n = (x: number) => x.toLocaleString('en-US');
const r1 = (x: number | null | undefined) => (typeof x === 'number' ? x.toFixed(1) : 'n/a');
const all: Vendor[] = [...g2.ranked, ...g2.unranked];
const rankOf = (v: Vendor) => g2.ranked.indexOf(v) + 1;
const totalReviews = all.reduce((s, v) => s + v.g2.reviews, 0);
const checked = fmtDate(SOFTWARE.updated);
const scoreKeys = Object.keys(c.scoreAvg);
const lc = (s = '') => (/^[A-Z][a-z]/.test(s) && !/^(SAP|Oracle|Microsoft|Salesforce|Workday|NetSuite|ServiceNow|Google|Slack|Unit4|European|Coupa|Ivalua)\b/.test(s) ? s.charAt(0).toLowerCase() + s.slice(1) : s);
const list = (xs: string[]) => xs.length <= 1 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`;
const lead = tiers[0];
const leadNames = lead ? lead.vendors.map((v) => `${v.name} (${r1(v.g2.rating)})`) : [];
const shortAnswer = lead
  ? (lead.vendors.length > 1
      ? `On G2, the leading ${c.name} platforms with at least ${SOFTWARE.minReviews} reviews are ${list(leadNames)}. Their ratings are within ${TIE} points of each other, so we treat them as effectively tied.`
      : `On G2, ${lead.vendors[0].name} leads ${c.name} platforms with at least ${SOFTWARE.minReviews} reviews, at ${r1(lead.vendors[0].g2.rating)} out of 5 from ${n(lead.vendors[0].g2.reviews)} reviews.`)
  : `No ${c.name} platform has yet met our minimum of ${SOFTWARE.minReviews} G2 reviews.`;
const teamLine = team.ranked.length ? `Our analysts rank ${team.ranked[0].v.name} first (score ${team.ranked[0].avg?.toFixed(2)} out of 5)${team.ranked[1] ? `, followed by ${team.ranked[1].v.name} (${team.ranked[1].avg?.toFixed(2)})` : ''}.` : `Our team's scoring for this category is in progress.`;
const teamRank = (v: Vendor) => team.ranked.findIndex((x) => x.v === v) + 1;
const byName = (name: string) => all.find((v) => v.name === name);
const crit = Object.fromEntries(SOFTWARE.rubric.map((r) => [r.id, r.label]));
const mostReviewed = picks[1]?.v;

const pairWho = (v: Vendor) => (v.bestFor ? lc(v.bestFor) : 'teams with its typical profile');
const pairText = (a: Vendor, b: Vendor) => {
  const d = Math.abs(a.g2.rating! - b.g2.rating!);
  const ma = mixOf(a), mb = mixOf(b);
  const parts = [
    `${a.name} is rated ${r1(a.g2.rating)} on G2 from ${n(a.g2.reviews)} reviews; ${b.name} is rated ${r1(b.g2.rating)} from ${n(b.g2.reviews)}. ${d < TIE ? `That gap of ${d.toFixed(1)} is within our ${TIE}-point tie band, so neither is clearly ahead on ratings alone.` : `${a.g2.rating! > b.g2.rating! ? a.name : b.name} leads by ${d.toFixed(1)} points.`}`,
    ma && mb ? `${a.name}'s reviewers skew ${ma.large >= mb.large ? 'more toward large enterprises' : 'more toward smaller companies'} (${ma.large}% enterprise versus ${mb.large}% for ${b.name}).` : '',
    `Pick ${a.name} for ${pairWho(a)}; pick ${b.name} for ${pairWho(b)}.`,
  ];
  return parts.filter(Boolean).join(' ');
};

const smallPick = picks[3]?.v, entPick = picks[2]?.v;
const faq = [
  { q: `What is ${sw} software?`, a: c.answer },
  { q: `What is the best ${sw} software in ${year}?`, a: `${shortAnswer} The right choice depends on company size, ERP and the processes you need covered; see the comparison table and vendor reviews on this page.` },
  ...(mostReviewed ? [{ q: `Which ${c.name} platform has the most G2 reviews?`, a: `${mostReviewed.name}, with ${n(mostReviewed.g2.reviews)} reviews and a ${r1(mostReviewed.g2.rating)} average rating (checked ${checked}).` }] : []),
  ...(smallPick ? [{ q: `What is the best ${sw} software for small businesses?`, a: `Among ranked vendors, ${smallPick.name} has the highest share of small-business reviewers on G2 (${mixOf(smallPick)?.small}%), and is rated ${r1(smallPick.g2.rating)}. It is best for ${pairWho(smallPick)}.` }] : []),
  ...(entPick ? [{ q: `What is the best ${sw} software for large enterprises?`, a: `Among ranked vendors, ${entPick.name} has the highest share of enterprise reviewers on G2 (${mixOf(entPick)?.large}% at companies with more than 1,000 employees), and is rated ${r1(entPick.g2.rating)}. It is best for ${pairWho(entPick)}.` }] : []),
  ...(pairs[0] ? [{ q: `${pairs[0][0].name} vs ${pairs[0][1].name}: which is better?`, a: `${pairText(pairs[0][0], pairs[0][1])}` }] : []),
  { q: `How much does ${sw} software cost?`, a: c.pricing },
  { q: `How long does ${sw} software take to implement?`, a: c.implementation },
  { q: `What should I look for when choosing ${sw} software?`, a: c.choose.map(([t, d]) => `${t}: ${d}`).join(' ') },
  ...(team.ranked.length ? [{ q: `Which ${sw} software does Procurement Signal rate highest?`, a: `${teamLine} ${team.ranked[0].v.take ?? ''}` }] : []),
  ...(c.market ? [{ q: `How is the ${sw} software market changing?`, a: `${c.market} ${(c.trends ?? []).join(' ')}` }] : []),
  { q: `How does Procurement Signal rank ${sw} software?`, a: `${SOFTWARE.method} ${SOFTWARE.disclosure}` },
];

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: `Best ${sw} software in ${year}: ${all.length} platforms compared`, description: c.answer, dateModified: SOFTWARE.updated, author: { '@type': 'Organization', name: 'Procurement Signal' }, publisher: { '@type': 'Organization', name: 'Procurement Signal' }, mainEntityOfPage: url },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: `${sw} software ranked by G2 rating`, url, numberOfItems: g2.ranked.length, itemListOrder: 'https://schema.org/ItemListOrderDescending',
    itemListElement: g2.ranked.map((v, i) => ({ '@type': 'ListItem', position: i + 1, name: v.name, url: `${url}#${slugify(v.name)}` })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: 'Software rankings', item: new URL('/software/', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: c.name, item: url } ] },
];
const others = allCategories().filter((x) => x.slug !== c.slug);
const toc = [
  ['answer', 'Short answer'], ...(c.market ? [['analysis', 'Our analysis']] : []), ['picks', 'Quick picks'], ['compare', 'Comparison table'], ['ranking', 'Rankings'],
  ['reviews', `All ${all.length} reviews`], ...(pairs.length ? [['versus', 'Head to head']] : []), ['choose', 'How to choose'],
  ['cost', 'Pricing and rollout'], ['faq', 'FAQ'], ['method', 'How we rank'],
];
---
<Base title={`Best ${sw} software in ${year}: ${all.length} platforms compared`} description={`${c.answer.split('. ')[0]}. ${all.length} platforms compared on G2 ratings, reviewer mix, strengths and complaints.`} section="software" jsonLd={jsonLd}>
  <header class="hero" style={`--c:${c.accent}`}>
    <div class="hero-in">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/software/">Software rankings</a> <span>/</span> {c.name}</nav>
      <p class="eyebrow">{c.short} software ranking · Updated {checked}</p>
      <h1>Best {sw} software in {year}</h1>
      <p class="dek">{all.length} platforms compared on G2 ratings, who uses them, what reviewers praise and what they complain about. {c.blurb}</p>
      <dl class="stats">
        <div><dt>Platforms compared</dt><dd>{all.length}</dd></div>
        <div><dt>Ranked (50+ reviews)</dt><dd>{g2.ranked.length}</dd></div>
        <div><dt>G2 reviews behind this page</dt><dd>{n(totalReviews)}</dd></div>
        {c.g2.avg && <div><dt>G2 category average</dt><dd>{c.g2.avg.toFixed(2)}</dd></div>}
      </dl>
      <div class="hero-act"><FollowButton slug={c.slug} name={c.name} /><a class="ghost" href="/software/finder/">Build a shortlist</a></div>
    </div>
  </header>

  <div class="layout">
    <aside class="toc" aria-label="On this page">
      <p>On this page</p>
      <ol>{toc.map(([id, t]) => <li><a href={`#${id}`}>{t}</a></li>)}</ol>
    </aside>

    <article class="body" data-pagefind-body style={`--c:${c.accent}`}>
      <section id="answer" class="answer">
        <h2 class="sr">Short answer</h2>
        <p><strong>Short answer:</strong> {shortAnswer} {teamLine}</p>
        <p>{c.answer}</p>
        <p class="disc"><strong>Disclosure.</strong> {SOFTWARE.disclosure}</p>
      </section>

      {c.market && (
        <section id="analysis" class="ana">
          <h2>Our analysis of the {sw} market</h2>
          <p class="ana-lede">{c.market}</p>
          {c.trends && c.trends.length > 0 && (
            <div class="ana-trends">
              <h3>What's changing</h3>
              <ol>{c.trends.map((t) => <li>{t}</li>)}</ol>
            </div>
          )}
          {c.scenarios && c.scenarios.length > 0 && (
            <>
              <h3 class="ana-h">Our shortlist by situation</h3>
              <div class="scen">
                {c.scenarios.map(([label, name, why]) => {
                  const v = byName(name); const avg = v ? teamAverage(v) : null;
                  return (
                    <a class="scen-c" href={`#${slugify(name)}`}>
                      <span class="scen-l">{label}</span>
                      <strong>{name}</strong>
                      <span class="scen-w">{why}</span>
                      <span class="scen-s">{avg !== null && <>Our score <b>{avg.toFixed(2)}</b></>}{v?.g2.rating && <> · G2 {r1(v.g2.rating)}</>}</span>
                    </a>
                  );
                })}
              </div>
            </>
          )}
          <p class="note">Analysis by the Procurement Signal team, updated {fmtDate(SOFTWARE.analysisUpdated ?? SOFTWARE.updated)}. Scores are editorial assessments, not hands-on product tests.</p>
        </section>
      )}

      {picks.length > 0 && (
        <section id="picks">
          <h2>Quick picks</h2>
          <p class="note">Drawn directly from G2 data among vendors with at least {SOFTWARE.minReviews} reviews. These are facts about the reviews, not endorsements.</p>
          <div class="picks">
            {picks.map((p) => (
              <a class="pick" href={`#${slugify(p.v.name)}`}>
                <span class="pl">{p.label}</span>
                <strong>{p.v.name}</strong>
                <span class="ps">{p.stat}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <section id="compare">
        <h2>{sw} software compared</h2>
        <p class="note">Ratings and reviewer mix from G2, checked {checked}. Enterprise means more than 1,000 employees; small business means 50 or fewer.</p>
        <div class="tscroll" tabindex="0" role="region" aria-label="Comparison table">
          <table class="cmp">
            <thead><tr><th>#</th><th>Platform</th><th>Best for</th><th>Our score</th><th>G2 rating</th><th>Reviews</th><th>Who reviews it</th><th>Founded · HQ</th></tr></thead>
            <tbody>
              {all.map((v) => {
                const m = mixOf(v); const rk = rankOf(v);
                return (
                  <tr class={rk ? '' : 'un'}>
                    <td class="rk">{rk || '–'}</td>
                    <td><a href={`#${slugify(v.name)}`}><strong>{v.name}</strong></a>{v.seller && v.seller !== v.name && <span class="sm">{v.seller}</span>}</td>
                    <td class="bf">{v.bestFor}</td>
                    <td class="num">{teamAverage(v) !== null ? <strong class="ours">{teamAverage(v)!.toFixed(2)}</strong> : '–'}{teamRank(v) > 0 && <span class="sm">#{teamRank(v)} by our team</span>}</td>
                    <td><span class="stars" style={`--w:${((v.g2.rating ?? 0) / 5) * 100}%`}>{r1(v.g2.rating)}</span></td>
                    <td class="num">{n(v.g2.reviews)}{!rk && <span class="sm">Below {SOFTWARE.minReviews}</span>}</td>
                    <td>{m ? <span class="mix" title={`Small ${m.small}% · Mid-market ${m.mid}% · Enterprise ${m.large}%`}><i class="s" style={`width:${m.small}%`}></i><i class="m" style={`width:${m.mid}%`}></i><i class="l" style={`width:${m.large}%`}></i></span> : <span class="sm">n/a</span>}</td>
                    <td class="sm2">{v.founded ?? '–'}{v.hq ? ` · ${v.hq}` : ''}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <p class="hint">Swipe the table sideways to see every column.</p>
        <p class="legend"><span><i class="s"></i>Small business</span><span><i class="m"></i>Mid-market</span><span><i class="l"></i>Enterprise</span></p>
      </section>

      <section id="ranking">
        <h2>The rankings</h2>
        <div class="rank2">
          <div class="rbox">
            <h3>G2 ranking, in tiers</h3>
            <p class="note">Vendors within {TIE} points of a tier's leader share the tier. Read the order inside a tier as a near tie.</p>
            {tiers.map((t, ti) => (
              <div class="tier">
                <p class="tl"><span>Tier {ti + 1}</span> {t.hi === t.lo ? r1(t.hi) : `${r1(t.lo)} to ${r1(t.hi)}`}</p>
                <ol>
                  {t.vendors.map((v) => (
                    <li><span class="tp">{rankOf(v)}</span><a href={`#${slugify(v.name)}`}>{v.name}</a><span class="bar"><i style={`width:${((v.g2.rating! - 3.5) / 1.5) * 100}%`}></i></span><b>{r1(v.g2.rating)}</b></li>
                  ))}
                </ol>
              </div>
            ))}
            {g2.unranked.length > 0 && <p class="note">Listed but not ranked (fewer than {SOFTWARE.minReviews} reviews): {g2.unranked.map((v) => `${v.name} (${n(v.g2.reviews)})`).join(', ')}.</p>}
          </div>
          <div class="rbox team">
            <h3>Our analysts' ranking</h3>
            {team.ranked.length ? (
              <ol class="tr">{team.ranked.map((x) => <li><a href={`#${slugify(x.v.name)}`}>{x.v.name}</a><span class="bar"><i style={`width:${((x.avg! - 2) / 3) * 100}%`}></i></span><b>{x.avg?.toFixed(2)}</b></li>)}</ol>
            ) : (
              <p class="pending">Our analysts are scoring this category now. Each platform gets a 1 to 5 score on the five criteria below, and the ranking is the average.</p>
            )}
            <p class="note">Average of five 1 to 5 scores:</p>
            <ol class="crit">{SOFTWARE.rubric.map((r) => <li>{r.label}</li>)}</ol>
            <p class="note">Editorial assessments based on documented capabilities, G2 review themes and implementation reports. Not hands-on tests.</p>
          </div>
        </div>
      </section>

      <section id="reviews">
        <h2>Reviews of all {all.length} {c.name} platforms</h2>
        <p class="note">Strengths and complaints are our summaries of recurring themes in G2 reviews, not quotes. Sub-scores are G2's 1 to 10 feature ratings against the category average.</p>
        {all.map((v) => {
          const m = mixOf(v); const rk = rankOf(v);
          return (
            <section class="vend" id={slugify(v.name)}>
              <header class="vh">
                <span class="vr">{rk ? `#${rk}` : 'Listed'}</span>
                <div>
                  <h3>{v.name}</h3>
                  <p class="vsub">{[v.seller && v.seller !== v.name ? v.seller : null, v.founded ? `founded ${v.founded}` : null, v.hq].filter(Boolean).join(' · ')}</p>
                </div>
                <div class="vg">
                  <strong>{r1(v.g2.rating)}</strong><span>G2 · {n(v.g2.reviews)} reviews</span>
                </div>
              </header>
              {v.bestFor && <p class="best"><span>Best for</span> {v.bestFor}</p>}
              {v.what && <p>{v.what}</p>}
              {v.take && (
                <div class="take">
                  <div class="take-t">
                    <h4>Our take</h4>
                    <p>{v.take}</p>
                  </div>
                  {v.team && teamAverage(v) !== null && (
                    <div class="take-s">
                      <p class="take-avg"><b>{teamAverage(v)!.toFixed(2)}</b><span>Our score{teamRank(v) > 0 && <>, #{teamRank(v)} of {team.ranked.length}</>}</span></p>
                      <ul>{SOFTWARE.rubric.map((r) => <li><span>{crit[r.id]}</span><span class="tb"><i style={`width:${(v.team![r.id] / 5) * 100}%`}></i></span><em>{v.team![r.id].toFixed(1)}</em></li>)}</ul>
                    </div>
                  )}
                </div>
              )}
              <div class="pc">
                {v.likes && v.likes.length > 0 && <div class="pros"><h4>What reviewers like</h4><ul>{v.likes.map((x) => <li>{x}</li>)}</ul></div>}
                {v.flags && v.flags.length > 0 && <div class="cons"><h4>Common complaints</h4><ul>{v.flags.map((x) => <li>{x}</li>)}</ul></div>}
              </div>
              {v.note && <p class="vnote">{v.note}</p>}
              <div class="vfoot">
                {v.scores && Object.keys(v.scores).length > 0 && (
                  <div class="subs">
                    {scoreKeys.filter((k) => v.scores![k] != null).map((k) => (
                      <div class="sub"><span>{k}</span><span class="sb"><i style={`width:${v.scores![k] * 10}%`}></i><em style={`left:${c.scoreAvg[k] * 10}%`} title={`Category average ${c.scoreAvg[k]}`}></em></span><b class={v.scores![k] >= c.scoreAvg[k] ? 'up' : 'dn'}>{v.scores![k].toFixed(1)}</b></div>
                    ))}
                    <p class="sm">Marker shows the category average.</p>
                  </div>
                )}
                {m && (
                  <div class="who">
                    <span class="mix big"><i class="s" style={`width:${m.small}%`}></i><i class="m" style={`width:${m.mid}%`}></i><i class="l" style={`width:${m.large}%`}></i></span>
                    <p class="sm">Reviewers: {m.small}% small business · {m.mid}% mid-market · {m.large}% enterprise</p>
                  </div>
                )}
              </div>
              <p class="vlink"><a href={v.g2.url} target="_blank" rel="noopener">Read {v.name} reviews on G2</a> · checked {fmtDate(v.g2.checked)}</p>
            </section>
          );
        })}
      </section>

      {pairs.length > 0 && (
        <section id="versus">
          <h2>Head to head</h2>
          <p class="note">The comparisons procurement teams ask about most in this category, built from the same G2 data.</p>
          {pairs.map(([a, b]) => (
            <div class="vs">
              <h3>{a.name} vs {b.name}</h3>
              <div class="vsgrid">
                {[a, b].map((v) => (
                  <div class="vsc">
                    <p class="vn">{v.name}</p>
                    <p class="vsr"><strong>{r1(v.g2.rating)}</strong> · {n(v.g2.reviews)} reviews</p>
                    {scoreKeys.filter((k) => v.scores?.[k] != null).map((k) => <p class="sm">{k}: {v.scores![k].toFixed(1)}</p>)}
                    {v.likes?.[0] && <p class="sm">Praised for: {lc(v.likes[0])}</p>}
                    {v.flags?.[0] && <p class="sm">Watch out for: {lc(v.flags[0])}</p>}
                  </div>
                ))}
              </div>
              <p>{a.name} is rated {r1(a.g2.rating)} from {n(a.g2.reviews)} reviews and {b.name} {r1(b.g2.rating)} from {n(b.g2.reviews)}. {Math.abs(a.g2.rating! - b.g2.rating!) < TIE ? `The ${Math.abs(a.g2.rating! - b.g2.rating!).toFixed(1)}-point gap is within our tie band, so fit matters more than the score.` : `${a.g2.rating! > b.g2.rating! ? a.name : b.name} leads by ${Math.abs(a.g2.rating! - b.g2.rating!).toFixed(1)} points.`} {mixOf(a) && mixOf(b) && `${mixOf(a)!.large}% of ${a.name}'s reviewers work at enterprises, against ${mixOf(b)!.large}% for ${b.name}.`}</p>
              <p><strong>Pick {a.name}</strong> for {pairWho(a)}. <strong>Pick {b.name}</strong> for {pairWho(b)}.</p>
            </div>
          ))}
        </section>
      )}

      <section id="choose">
        <h2>How to choose {sw} software</h2>
        <ol class="choose">{c.choose.map(([t, d]) => <li><strong>{t}</strong><span>{d}</span></li>)}</ol>
      </section>

      <section id="cost" class="cost">
        <div><h2>What it costs</h2><p>{c.pricing}</p></div>
        <div><h2>How long it takes</h2><p>{c.implementation}</p></div>
      </section>

      {c.candidates.length > 0 && (
        <section class="cands">
          <h2>Also on our radar</h2>
          <p>{list(c.candidates)} are active in this category but have too little public review data for us to rank yet.</p>
        </section>
      )}

      <section id="faq">
        <h2>Frequently asked questions</h2>
        <div class="faq">{faq.map((f, i) => <details open={i < 2}><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
      </section>

      <section id="method" class="method">
        <h2>How we rank</h2>
        <p>{SOFTWARE.method}</p>
        <p>{SOFTWARE.disclosure}</p>
      </section>

      <Subscribe title="Get ranking updates" text="We email when ratings shift, new vendors qualify or our team publishes scores." />

      <section class="srcs">
        <h2>Sources</h2>
        <ul>
          <li><a href={c.g2.url} target="_blank" rel="noopener">G2: {c.g2.category} category ({n(c.g2.products)} products listed)</a></li>
          {all.map((v) => <li><a href={v.g2.url} target="_blank" rel="noopener">G2: {v.name} reviews</a>, checked {fmtDate(v.g2.checked)}</li>)}
        </ul>
      </section>
    </article>
  </div>

  <section class="more">
    <div class="more-in">
      <h2>More software rankings</h2>
      <div class="more-grid">
        {others.map((o) => (
          <a href={`/software/${o.slug}/`} style={`--c:${o.accent}`}><span>{o.short}</span><strong>{o.name}</strong><em>{o.vendors.length} platforms</em></a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .ana { background: #fff; border: 1px solid var(--rule); border-top: 5px solid var(--c); padding: 22px 24px 18px; }
  .ana h2 { margin-top: 0 !important; }
