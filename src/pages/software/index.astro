---
import Base from '../../layouts/Base.astro';
import { softwareCategories, overall } from '../../data/software';
const allDraft = softwareCategories.every((c) => c.status === 'draft');
---
<Base title="Top procurement software rankings" description="Independent rankings of procurement software: procure-to-pay, source-to-contract, spend analytics, supplier risk, contract management and AP automation." section="software" noindex={allDraft}>
  <div class="page">
    <div class="page-head narrow">
      <h1>Top Software</h1>
      <p>Independent rankings of the tools procurement teams buy, scored on six criteria by our analysts, with G2 peer reviews alongside. Vendors cannot pay for placement.</p>
    </div>
    {allDraft && <p class="draft-note"><strong>Draft rankings.</strong> Scores and analysis are under editorial review and may change before publication.</p>}
    <div class="sw-grid">
      {softwareCategories.map((c) => (
        <section class="sw-card">
          <h2><a href={`/software/${c.id}/`}>{c.name}</a></h2>
          <p>{c.description}</p>
          <ol>
            {c.products.slice(0, 3).map((p) => <li><span>{p.name}</span><b>{overall(p).toFixed(1)}</b></li>)}
          </ol>
          <a class="more" href={`/software/${c.id}/`}>See the full ranking</a>
        </section>
      ))}
    </div>
    <div class="tool-band" style="margin-top:36px">
      <div>
        <h2>Software Finder</h2>
        <p>Four questions, a shortlist matched to your company size, ERP and priorities.</p>
      </div>
      <a class="button" href="/software/finder/">Find your shortlist</a>
    </div>
    <p class="meta" style="margin-top:20px"><a class="link" href="/software/methodology/">How we score software</a></p>
  </div>
</Base>
