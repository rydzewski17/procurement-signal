---
import Base from '../../layouts/Base.astro';
import Subscribe from '../../components/Subscribe.astro';
import { SOFTWARE, rankG2, rankTeam, g2Tiers, fmtDate, slugify, crossCategory, mixOf, TIE } from '../../data/software';
const firstSentence = (t = '') => (t.match(/^.*?\.(\s|$)/)?.[0] ?? t).trim();
const watching = SOFTWARE.categories.filter((c) => c.trends?.length).map((c) => ({ c, t: c.trends![0] })).slice(0, 6);

const cats = SOFTWARE.categories;
const n = (x: number) => x.toLocaleString('en-US');
const listings = cats.reduce((s, c) => s + c.vendors.length, 0);
const names = new Set(cats.flatMap((c) => c.vendors.map((v) => v.name)));
const reviews = new Map<string, number>();
for (const c of cats) for (const v of c.vendors) reviews.set(v.g2.url, v.g2.reviews);
const totalReviews = [...reviews.values()].reduce((a, b) => a + b, 0);
const year = new Date(SOFTWARE.updated + 'T00:00:00Z').getUTCFullYear();
const cross = crossCategory(3);
const byName = (c: typeof cats[number], name: string) => c.vendors.find((v) => v.name === name);
const url = new URL('/software/', Astro.site).toString();
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: `Procurement software rankings ${year}`, url, dateModified: SOFTWARE.updated,
    mainEntity: { '@type': 'ItemList', numberOfItems: cats.length, itemListElement: cats.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: `Best ${c.name.replace(/ software$/i, '')} software`, url: new URL(`/software/${c.slug}/`, Astro.site).toString() })) } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: 'Software rankings', item: url } ] },
];
---
<Base title={`Procurement software rankings ${year}: ${cats.length} categories compared`} description={`${n(names.size)} procurement, payment, contract, spend, risk and sourcing platforms compared across ${cats.length} categories, using ${n(totalReviews)} G2 reviews and our team's analysis.`} section="software" jsonLd={jsonLd}>
  <header class="hero">
    <div class="hero-in">
      <div>
        <p class="eyebrow">Software rankings · Updated {fmtDate(SOFTWARE.updated)}</p>
        <h1>The procurement software rankings</h1>
        <p class="dek">Every major platform for buying, paying, contracting and managing suppliers, compared side by side. Ranked on public G2 ratings and by our own analysts, with no paid placements.</p>
        <div class="acts">
          <a class="btn" href="/software/finder/">Get your shortlist in four questions</a>
          <a class="lnk" href="#method">How we rank</a>
        </div>
      </div>
      <dl class="stats">
        <div><dd>{cats.length}</dd><dt>software categories</dt></div>
        <div><dd>{names.size}</dd><dt>platforms reviewed</dt></div>
        <div><dd>{listings}</dd><dt>category listings</dt></div>
        <div><dd>{n(Math.round(totalReviews / 1000))}k</dd><dt>G2 reviews analyzed</dt></div>
      </dl>
    </div>
    <nav class="jump" aria-label="Software categories">
      {cats.map((c) => <a href={`/software/${c.slug}/`} style={`--c:${c.accent}`}>{c.short}</a>)}
    </nav>
  </header>

  <section class="grid" aria-label="Rankings by category">
    {cats.map((c) => {
      const tiers = g2Tiers(c); const top = rankG2(c).ranked.slice(0, 3); const team = rankTeam(c).ranked[0];
      const lead = tiers[0]?.vendors ?? [];
      return (
        <article class="tile" style={`--c:${c.accent}`}>
          <a class="tile-head" href={`/software/${c.slug}/`}>
            <span class="tag">{c.short}</span>
            <h2>{c.name}</h2>
            <span class="count">{c.vendors.length} platforms</span>
          </a>
          <div class="tile-body">
            <p class="blurb">{c.blurb}</p>
            <p class="lbl">Highest rated on G2</p>
            <ol class="podium">
              {top.map((v, i) => (
                <li>
                  <span class="pos">{i + 1}</span>
                  <a href={`/software/${c.slug}/#${slugify(v.name)}`}>{v.name}</a>
                  <span class="meter"><i style={`width:${((v.g2.rating! - 3.5) / 1.5) * 100}%`}></i></span>
                  <b>{v.g2.rating!.toFixed(1)}</b>
                </li>
              ))}
            </ol>
            <p class="tie">{lead.length > 1 ? `${lead.length} platforms are within ${TIE} points of the leader, so the top is effectively a tie.` : `${lead[0]?.name} leads by ${TIE} points or more.`}</p>
            {team && (
              <a class="our" href={`/software/${c.slug}/#${slugify(team.v.name)}`}>
                <span class="our-l">Our analysts' pick</span>
                <span class="our-n"><strong>{team.v.name}</strong><b>{team.avg?.toFixed(2)}</b></span>
                {team.v.take && <span class="our-t">{firstSentence(team.v.take)}</span>}
              </a>
            )}
            {c.market && <p class="mkt"><strong>Market view.</strong> {firstSentence(c.market)}</p>}
            <a class="go" href={`/software/${c.slug}/`}>Compare all {c.vendors.length} {c.short} platforms</a>
          </div>
        </article>
      );
    })}
  </section>

  <section class="watch-sw">
    <h2>What we're watching in procurement software</h2>
    <p class="note">Our analysts' read on the shifts that matter most when you evaluate tools this year.</p>
    <div class="ws-grid">
      {watching.map(({ c, t }) => (
        <a class="ws" href={`/software/${c.slug}/#analysis`} style={`--c:${c.accent}`}>
          <span>{c.name}</span>
          <p>{t}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="matrix-wrap">
    <h2>Platforms that span categories</h2>
    <p class="note">Suites show up in several rankings. Their G2 rating is the same everywhere; what changes is who they compete against. Each cell links to that platform's review in that category.</p>
    <div class="tscroll" tabindex="0" role="region" aria-label="Platforms by category">
      <table class="matrix">
        <thead><tr><th>Platform</th>{cats.map((c) => <th style={`--c:${c.accent}`}><a href={`/software/${c.slug}/`}>{c.short}</a></th>)}</tr></thead>
        <tbody>
          {cross.map((e) => (
            <tr>
              <th scope="row">{e.name}<span>{e.cats.length} categories</span></th>
              {cats.map((c) => {
                const v = byName(c, e.name);
                if (!v) return <td class="empty"></td>;
                const rk = rankG2(c).ranked.indexOf(v) + 1;
                return <td style={`--c:${c.accent}`}><a href={`/software/${c.slug}/#${slugify(v.name)}`} title={`${v.name} in ${c.name}`}>{rk ? `#${rk}` : 'Listed'}<small>of {c.vendors.length}</small></a></td>;
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="how" id="method">
    <h2>How we rank</h2>
    <div class="how-grid">
      <div class="how-c g2c"><span class="ic">1</span><h3>Public ratings</h3><p>We rank platforms by their G2 average rating. A platform needs at least {SOFTWARE.minReviews} reviews to be ranked, and ratings within {TIE} points are shown as a tier, not a strict order.</p></div>
      <div class="how-c tc"><span class="ic">2</span><h3>Our analysts</h3><p>Our team scores each platform from 1 to 5 on {SOFTWARE.rubric.map((r) => r.label.toLowerCase().replace('erp', 'ERP')).join(', ')}. The team ranking is the average.</p></div>
      <div class="how-c ic3"><span class="ic">3</span><h3>Independence</h3><p>{SOFTWARE.disclosure}</p></div>
    </div>
  </section>

  <section class="cta">
    <div>
      <h2>Not sure which category you need?</h2>
      <p>Answer four quick questions about the problem you need to fix, your company size, your priorities and your platforms. We match you to a category and a shortlist of three, with our scores and the questions to ask in demos.</p>
    </div>
    <a class="btn" href="/software/finder/">Open the shortlist finder</a>
  </section>

  <div class="subwrap"><Subscribe title="Get ranking updates" text="We email when ratings shift, new platforms qualify or our analysts publish scores." /></div>
</Base>

<style>
  .our { display: block; margin: 12px 0 8px; padding: 12px 14px; background: var(--navy-tint); border-left: 4px solid var(--c); text-decoration: none; color: var(--ink); }
  .our:hover { background: #e3e9f0; }
  .our-l { display: block; font: 600 11.5px/1 var(--ui); color: var(--c); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 6px; }
  .our-n { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  .our-n strong { font: 700 18px/1.2 var(--head); }
  .our-n b { font: 700 18px/1 var(--head); color: var(--c); }
  .our-t { display: block; font: 13.5px/1.45 var(--ui); color: var(--ink-2); margin-top: 6px; }
  .mkt { font: 13.5px/1.5 var(--ui); color: var(--muted); margin: 0 0 10px; }
  .mkt strong { color: var(--ink); }
  .watch-sw { max-width: var(--max); margin: 46px auto 0; }
  .watch-sw h2 { font: 700 28px/1.15 var(--head); margin: 0 0 6px; }
  .ws-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 14px; }
  .ws { display: block; padding: 16px 18px; border: 1px solid var(--rule); border-top: 4px solid var(--c); text-decoration: none; color: var(--ink); background: #fff; }
  .ws:hover { box-shadow: 0 10px 24px rgba(14,42,71,.12); }
  .ws span { font: 600 12px/1 var(--ui); color: var(--c); text-transform: uppercase; letter-spacing: .05em; }
  .ws p { margin: 8px 0 0; font: 16px/1.5 var(--head); }
  @media (max-width: 860px) { .ws-grid { grid-template-columns: 1fr; } }
  .hero { margin: 0 calc(50% - 50vw); background: var(--navy); color: #fff; position: relative; overflow: hidden; }
  .hero::before { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(90deg, transparent 0 46px, rgba(255,255,255,.035) 46px 48px); }
  .hero-in { position: relative; max-width: var(--max); margin: 0 auto; padding: 40px 20px 30px; display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 40px; align-items: end; }
  .eyebrow { font: 600 13px/1 var(--ui); color: #8fd3cf; margin: 0 0 12px; }
  .hero h1 { color: #fff; font: 700 clamp(34px, 5.4vw, 58px)/1.02 var(--head); margin: 0 0 14px; }
  .dek { font: 19px/1.5 var(--head); color: rgba(255,255,255,.9); margin: 0 0 22px; max-width: 640px; }
  .acts { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; }
  .btn { display: inline-block; background: var(--red); color: #fff; font: 600 15px/1 var(--ui); padding: 14px 18px; border-radius: 3px; text-decoration: none; }
  .btn:hover { background: #8f1d17; }
  .lnk { color: #fff; font: 600 15px/1 var(--ui); }
  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: rgba(255,255,255,.18); margin: 0; }
  .stats div { background: var(--navy); padding: 16px 18px; }
  .stats dd { margin: 0; font: 700 40px/1 var(--head); color: #fff; }
  .stats dt { font: 13px/1.3 var(--ui); color: rgba(255,255,255,.7); margin-top: 6px; }
  .jump { position: relative; max-width: var(--max); margin: 0 auto; padding: 0 20px; display: flex; gap: 0; overflow-x: auto; scrollbar-width: none; }
  .jump a { flex: 1 0 auto; text-align: center; color: #fff; text-decoration: none; font: 600 14px/1 var(--ui); padding: 14px 16px; border-top: 5px solid var(--c); background: rgba(255,255,255,.05); }
  .jump a:hover { background: var(--c); }

  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; margin: 36px 0 10px; }
  .tile { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 1fr; background: #fff; border: 1px solid var(--rule); box-shadow: 0 1px 0 var(--rule); transition: box-shadow .15s; }
  .tile:hover { box-shadow: 0 10px 28px rgba(14,42,71,.12); }
  .tile-head { background: var(--c); color: #fff; padding: 14px 18px; text-decoration: none; display: flex; flex-direction: row; align-items: baseline; gap: 12px; position: relative; overflow: hidden; }
  .tile-head::after { content: ''; position: absolute; right: -40px; bottom: -40px; width: 120px; height: 120px; border-radius: 50%; border: 18px solid rgba(255,255,255,.1); }
  .tag { font: 700 24px/1.1 var(--head); white-space: nowrap; flex: 0 0 auto; }
  .tile-head h2 { color: rgba(255,255,255,.92); font: 600 14.5px/1.3 var(--ui); margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; flex: 1 1 auto; }
  .count { margin-left: auto; font: 600 12px/1 var(--ui); background: rgba(255,255,255,.18); padding: 6px 8px; align-self: center; white-space: nowrap; flex: 0 0 auto; }
  .tile-body { padding: 16px 18px 16px; display: flex; flex-direction: column; min-width: 0; }
  .blurb { font: 15px/1.45 var(--head); color: var(--ink-2); margin: 0 0 12px; }
  .lbl { font: 600 12px/1 var(--ui); color: var(--c); margin: 0 0 6px; }
  .podium { list-style: none; margin: 0; padding: 0; }
  .podium li { display: grid; grid-template-columns: 20px minmax(0, 1fr) 70px 30px; gap: 8px; align-items: center; padding: 6px 0; border-bottom: 1px solid var(--rule); font: 14px/1.2 var(--ui); }
  .pos { font: 700 15px/1 var(--head); color: var(--c); }
  .podium a { color: var(--ink); font-weight: 600; text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .podium a:hover { text-decoration: underline; }
  .meter { height: 6px; background: var(--rule); }
  .meter i { display: block; height: 100%; background: var(--c); }
  .podium b { text-align: right; }
  .tie { font: 12px/1.4 var(--ui); color: var(--muted); margin: 8px 0 2px; }
  .team { font: 600 12px/1.4 var(--ui); color: var(--ink-2); margin: 0 0 12px; }
  .go { margin-top: auto; font: 600 14px/1.2 var(--ui); color: var(--c); text-decoration: none; }
  .go::after { content: ' →'; }
  .go:hover { text-decoration: underline; }

  .matrix-wrap h2, .how h2 { font: 700 30px/1.2 var(--head); margin: 44px 0 6px; }
  .note { font: 15px/1.5 var(--ui); color: var(--muted); margin: 0 0 16px; max-width: 780px; }
  .tscroll { overflow-x: auto; border: 1px solid var(--rule); }
  .matrix { border-collapse: collapse; width: 100%; min-width: 820px; font: 14px/1.2 var(--ui); }
  .matrix thead th { background: #fff; padding: 0; border-bottom: 1px solid var(--rule); text-align: center; }
  .matrix thead th:first-child { text-align: left; padding: 10px 14px; font-weight: 600; color: var(--muted); }
  .matrix thead th a { display: block; padding: 12px 6px 10px; color: var(--c); font-weight: 700; text-decoration: none; border-top: 5px solid var(--c); }
  .matrix tbody th { text-align: left; padding: 10px 14px; font-weight: 700; white-space: nowrap; border-top: 1px solid var(--rule); }
  .matrix tbody th span { display: block; font: 12px/1 var(--ui); color: var(--muted); margin-top: 3px; }
  .matrix td { border-top: 1px solid var(--rule); border-left: 1px solid #f0f2f5; text-align: center; padding: 4px; }
  .matrix td a { display: block; background: color-mix(in srgb, var(--c) 12%, #fff); color: var(--c); text-decoration: none; padding: 8px 4px; font-weight: 700; }
  .matrix td a:hover { background: var(--c); color: #fff; }
  .matrix td small { display: block; font: 11px/1 var(--ui); opacity: .8; margin-top: 2px; }
  .matrix td.empty { background: repeating-linear-gradient(45deg, #fafbfc 0 6px, #f3f5f8 6px 7px); }

  .how-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 14px; }
  .how-c { padding: 22px; position: relative; }
  .how-c h3 { font: 700 21px/1.2 var(--head); margin: 8px 0 8px; }
  .how-c p { font: 15px/1.55 var(--ui); color: var(--ink-2); margin: 0; }
  .ic { display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; color: #fff; font: 700 16px/1 var(--ui); }
  .g2c { background: var(--teal-tint); } .g2c .ic { background: var(--teal); }
  .tc { background: var(--navy-tint); } .tc .ic { background: var(--navy); }
  .ic3 { background: var(--amber-tint); } .ic3 .ic { background: var(--amber); }

  .cta { margin: 40px 0 0; background: linear-gradient(110deg, var(--teal) 0%, #0b5f5d 100%); color: #fff; padding: 28px 30px; display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .cta h2 { color: #fff; font: 700 26px/1.2 var(--head); margin: 0 0 6px; }
  .cta p { margin: 0; font: 16px/1.5 var(--ui); max-width: 620px; color: rgba(255,255,255,.9); }
  .subwrap { margin: 30px 0 50px; }

  @media (max-width: 980px) {
    .hero-in { grid-template-columns: 1fr; gap: 24px; }
    .grid { grid-template-columns: 1fr; }
    .how-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .stats dd { font-size: 30px; }
    .tile { grid-template-columns: 1fr; }
    .tile-head { flex-wrap: wrap; gap: 4px 12px; }
    .tile-head h2 { flex-basis: 100%; order: 3; white-space: normal; }
    .jump a { flex: 0 0 auto; }
  }
</style>
