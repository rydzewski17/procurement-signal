---
import '../styles/global.css';
import '../styles/modern.css';
import '../styles/v3.css';
import '../styles/v4.css';
import NewsletterBand from '../components/v4/NewsletterBand.astro';
import { SITE, TOPICS } from '../data/site';
import LiveBar from '../components/LiveBar.astro';
import { CATEGORIES, NEWS_GROUPS, SECTIONS, categoryBySlug } from '../data/categories.mjs';
import { SOFTWARE, status } from '../data/software';

interface Props { title?: string; description?: string; type?: 'website' | 'article'; jsonLd?: object; section?: string; }
const { title, description = SITE.description, type = 'website', jsonLd, section } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const today = new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title ?? SITE.name} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,600;6..72,700&display=swap" rel="stylesheet" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <div class="progress" aria-hidden="true"></div>
  <div class="utility">
    <div class="wrap">
      <span>{today}</span>
      <span><a href="/rss.xml">RSS</a>&ensp;&ensp;<a href="/about/">About</a>&ensp;&ensp;<a href="/editorial-standards/">Editorial standards</a></span>
    </div>
  </div>
  <header class="masthead">
    <div class="wrap">
      <div><a href="/" class="wordmark"><span class="wm-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>{SITE.name}</a><span class="wm-tag">{SITE.tagline}</span></div>
      <div class="masthead-tools">
        <form class="msearch" action="/search/" method="get" role="search">
          <label class="sr-only" for="q-top">Search Procurement Signal</label>
          <input id="q-top" name="q" type="search" placeholder="Search stories, tariffs, software" />
          <button type="submit" aria-label="Search"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg></button>
        </form>
        <a class="subscribe" href="#newsletter">Get the newsletter</a>
      </div>
    </div>
  </header>
  <nav class="nav" aria-label="Main">
    <div class="wrap">
      <button class="mnav-btn" type="button" aria-expanded="false" aria-controls="mnav">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        Menu
      </button>
      <a href="/" class="nav-link" aria-current={section === 'home' ? 'page' : undefined}>Home</a>

      <div class="dd">
        <a class="dd-btn" href="/categories/" aria-haspopup="true" aria-current={section === 'categories' ? 'page' : undefined}>News<span class="caret" aria-hidden="true">▾</span></a>
        <div class="dd-menu dd-mega" role="menu">
          <div class="dd-group">
            <span class="dd-gname">Sections</span>
            {SECTIONS.map((sx) => <a href={`/sections/${sx.id}/`} role="menuitem">{sx.name}</a>)}
          </div>
          {NEWS_GROUPS.map((g) => (
            <div class="dd-group">
              <span class="dd-gname">{g.name}</span>
              {g.slugs.map((sl) => <a href={`/categories/${sl}/`} role="menuitem">{categoryBySlug[sl].name}</a>)}
            </div>
          ))}
          <div class="dd-foot"><a href="/" role="menuitem">Latest news</a><a href="/archive/" role="menuitem">All stories</a><a href="/categories/" role="menuitem">Every topic</a></div>
        </div>
      </div>

      <div class="dd">
        <a class="dd-btn" href="/signals/" aria-haspopup="true" aria-current={section === 'signals' || section === 'guides' ? 'page' : undefined}>Analysis<span class="caret" aria-hidden="true">▾</span></a>
        <div class="dd-menu dd-desc" role="menu">
          <a href="/signals/" role="menuitem"><b>Procurement briefings</b><span>What changed this week and what to do about it</span></a>
          <a href="/guides/" role="menuitem"><b>Guides</b><span>How tariffs, price indexes and supplier risk work</span></a>
          <a href="/glossary/" role="menuitem"><b>Glossary</b><span>Procurement and trade terms in plain language</span></a>
        </div>
      </div>

      <div class="dd">
        <a class="dd-btn" href="/cost-monitor/" aria-haspopup="true" aria-current={['cost-monitor', 'markets', 'trackers', 'wire'].includes(section ?? '') ? 'page' : undefined}>Prices &amp; data<span class="caret" aria-hidden="true">▾</span></a>
        <div class="dd-menu dd-desc" role="menu">
          <a href="/cost-monitor/" role="menuitem"><b>Price trends by category</b><span>Monthly prices for steel, freight, resins and 9 more</span></a>
          <a href="/trackers/tariff-deadlines/" role="menuitem"><b>Tariff deadlines</b><span>Dates when duties start, change or expire</span></a>
          <a href="/markets/" role="menuitem"><b>Prediction market odds</b><span>What traders expect on tariffs, rates and fuel</span></a>
          <a href="/signals/" role="menuitem"><b>Procurement briefings</b><span>Our signal reports, rated by urgency</span></a>
        </div>
      </div>

      <div class="dd dd-feature">
        <a class="dd-btn" href="/software/" aria-haspopup="true" aria-current={section === 'software' ? 'page' : undefined}>Software rankings<span class="caret" aria-hidden="true">▾</span></a>
        <div class="dd-menu" role="menu">
          <span class="dd-head">Ranked by our team and by G2</span>
          {SOFTWARE.categories.map((c) => <a href={`/software/${c.slug}/`} role="menuitem">{c.name}<span class={`dd-st ${status(c)}`}>{status(c) === 'ranked' ? 'Ranked' : 'Coming soon'}</span></a>)}
          <a class="dd-all" href="/software/finder/" role="menuitem">Not sure what you need? Use the software finder</a>
        </div>
      </div>
    </div>
    <div class="mnav" id="mnav" hidden>
      <div class="wrap">
        <form action="/search/" method="get" role="search" class="mnav-search">
          <label class="sr-only" for="q-m">Search Procurement Signal</label>
          <input id="q-m" name="q" type="search" placeholder="Search stories" />
          <button type="submit">Search</button>
        </form>
        <div class="mnav-group"><span>Sections</span>{SECTIONS.map((sx) => <a href={`/sections/${sx.id}/`}>{sx.name}</a>)}</div>
        <div class="mnav-group"><span>Analysis</span><a href="/signals/">Procurement briefings</a><a href="/guides/">Guides</a><a href="/glossary/">Glossary</a></div>
        <div class="mnav-group"><span>Prices and data</span><a href="/cost-monitor/">Price trends by category</a><a href="/trackers/tariff-deadlines/">Tariff deadlines</a><a href="/markets/">Prediction market odds</a></div>
        <div class="mnav-group"><span>Software</span><a href="/software/">Software rankings</a><a href="/software/finder/">Software finder</a></div>
      </div>
    </div>
  </nav>
  <LiveBar />
  <main class="wrap"><slot /></main>
  <div id="newsletter"><NewsletterBand /></div>
  <footer>
    <div class="wrap">
      <div class="cols">
        <div>
          <div class="wordmark"><span class="wm-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>{SITE.name}</div>
          <p style="max-width:360px;margin:10px 0 0">{SITE.description}</p>
        </div>
        <nav aria-label="Footer">
          <a href="/about/">About us</a>
          <a href="/trackers/">Trackers</a>
          <a href="/cost-monitor/">Price trends by category</a>
          <a href="/categories/">Categories</a>
          <a href="/software/">Software rankings</a>
          <a href="/software/finder/">Software finder</a>
          <a href="/editorial-standards/">Editorial standards</a>
          <a href="/guides/">Guides</a>
          <a href="/glossary/">Glossary</a>
          <a href="/archive/">Archive</a>
          <a href="/rss.xml">RSS feed</a>
          <a href="/sitemap-index.xml">Sitemap</a>
        </nav>
      </div>
      <div class="fine">© {new Date().getFullYear()} {SITE.name}. An independent publication. Stories link to their original sources.</div>
    </div>
  </footer>
<script is:inline>
  (() => {
    const b = document.querySelector('.mnav-btn'), m = document.getElementById('mnav');
    if (b && m) b.addEventListener('click', () => { const open = b.getAttribute('aria-expanded') === 'true'; b.setAttribute('aria-expanded', String(!open)); m.hidden = open; });
  })();
  (() => {
    const bar = document.querySelector('.progress');
    if (!bar) return;
    const onScroll = () => {
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      bar.style.width = max > 0 ? (h.scrollTop / max) * 100 + '%' : '0';
    };
    addEventListener('scroll', onScroll, { passive: true }); onScroll();
  })();
</script>
</body>
</html>
