---
import '../styles/global.css';
import { SITE, TOPICS } from '../data/site';
import LiveBar from '../components/LiveBar.astro';
import NewsletterBand from '../components/NewsletterBand.astro';

interface Props { title?: string; description?: string; type?: 'website' | 'article'; jsonLd?: object | object[]; section?: string; noindex?: boolean; }
const { title, description = SITE.description, type = 'website', jsonLd, section, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const today = new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
const navTopics = ['tariffs-trade', 'supplier-risk', 'commodities', 'proc-tech', 'ai-procurement', 'public-sector', 'esg-regulation'];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title ?? SITE.name} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap" rel="stylesheet" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <div class="utility">
    <div class="wrap">
      <span>{today}</span>
      <span><a href="/rss.xml">RSS</a>&ensp;&ensp;<a href="/about/">About</a></span>
    </div>
  </div>
  <header class="masthead">
    <a href="/" class="wordmark">{SITE.name}</a>
    <p class="tag">{SITE.tagline}</p>
  </header>
  <nav class="nav" aria-label="Sections">
    <div class="wrap">
      {navTopics.map((t) => <a href={`/topics/${t}/`} aria-current={section === t ? 'page' : undefined}>{TOPICS[t].name}</a>)}
      <a href="/software/" class="nav-feature" aria-current={section === 'software' ? 'page' : undefined}>Top Software</a>
      <a href="/outlook/" class="nav-feature" aria-current={section === 'outlook' || section === 'cost-monitor' ? 'page' : undefined}>Market Outlook</a>
      <a href="/guides/" aria-current={section === 'guides' ? 'page' : undefined}>Guides</a>
    </div>
  </nav>
  <LiveBar />
  <main class="wrap"><slot /></main>
  <NewsletterBand />
  <footer>
    <div class="wrap">
      <div class="cols">
        <div>
          <div class="wordmark">{SITE.name}</div>
          <p style="max-width:360px;margin:10px 0 0">{SITE.description}</p>
        </div>
        <nav aria-label="Footer">
          <a href="/about/">About us</a>
          <a href="/software/">Top Software</a>
          <a href="/software/finder/">Software Finder</a>
          <a href="/outlook/">Market Outlook</a>
          <a href="/cost-monitor/">Cost Pressure Monitor</a>
          <a href="/trackers/">Trackers</a>
          <a href="/editorial-standards/">Editorial standards</a>
          <a href="/guides/">Guides</a>
          <a href="/glossary/">Glossary</a>
          <a href="/wire/">Industry Wire</a>
          <a href="/archive/">Archive</a>
          <a href="/rss.xml">RSS feed</a>
          <a href="/sitemap-index.xml">Sitemap</a>
        </nav>
      </div>
      <div class="fine">© {new Date().getFullYear()} {SITE.name}. An independent publication. Stories link to their original sources.</div>
    </div>
  </footer>
</body>
</html>
