---
import '../styles/global.css';
import '../styles/modern.css';
import '../styles/v3.css';
import '../styles/v4.css';
import NewsletterBand from '../components/v4/NewsletterBand.astro';
import { SITE, TOPICS } from '../data/site';
import LiveBar from '../components/LiveBar.astro';
import { CATEGORIES, NEWS_GROUPS, SECTIONS, categoryBySlug } from '../data/categories.mjs';
import { SOFTWARE, status } from '../data/software';
import { getPosts } from '../data/posts';

const LABELS: Record<string, string> = { procurement: 'Procurement', 'digital-procurement': 'Tech & AI', trade: 'Trade & policy', 'supply-chain': 'Supply chain', costs: 'Costs', companies: 'Companies' };
const allPosts = await getPosts();
const navSections = SECTIONS.map((sx) => ({ s: sx, label: LABELS[sx.id] ?? sx.name, latest: allPosts.filter((p: any) => sx.slugs.includes(p.data.categories?.[0])).slice(0, 3) }));

interface Props { title?: string; description?: string; type?: 'website' | 'article'; jsonLd?: object; section?: string; }
const { title, description = SITE.description, type = 'website', jsonLd, section } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const today = new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title ?? SITE.name} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Raleway:wght@500;700;800&family=Newsreader:opsz,wght@6..72,400;6..72,600;6..72,700&display=swap" rel="stylesheet" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <div class="progress" aria-hidden="true"></div>
  <div class="utility">
    <div class="wrap">
      <span>{today}</span>
      <span><a href="/rss.xml">RSS</a>&ensp;&ensp;<a href="/about/">About</a>&ensp;&ensp;<a href="/editorial-standards/">Editorial standards</a></span>
    </div>
  </div>
  <header class="masthead">
    <div class="wrap">
      <div><a href="/" class="wordmark"><span class="wm-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>{SITE.name}</a><span class="wm-tag">{SITE.tagline}</span></div>
      <div class="masthead-tools">
        <form class="msearch" action="/search/" method="get" role="search">
          <label class="sr-only" for="q-top">Search Procurement Signal</label>
          <input id="q-top" name="q" type="search" placeholder="Search stories, tariffs, software" />
          <button type="submit" aria-label="Search"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg></button>
        </form>
        <a class="subscribe" href="#newsletter">Get the newsletter</a>
      </div>
    </div>
  </header>
  <nav class="nav5" aria-label="Main">
    <div class="wrap n5-bar">
      <a href="/" class="n5-mark" aria-label={`${SITE.name} home`}><span class="wm-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span></a>
      <button class="mnav-btn" type="button" aria-expanded="false" aria-controls="mnav">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        Menu
      </button>
      <ul class="n5-main">
        {navSections.map((n, i) => (
          <li class={`n5-item${i >= navSections.length - 2 ? ' n5-r' : ''}`}>
            <a class="n5-btn" href={`/sections/${n.s.id}/`} aria-current={section === n.s.id ? 'page' : undefined}>{n.label}</a>
            <div class="n5-panel">
              <div class="n5-col">
                <span class="n5-h">{n.s.name}</span>
                {n.s.slugs.map((sl: string) => <a href={`/categories/${sl}/`}>{categoryBySlug[sl].name}</a>)}
                <a class="n5-all" href={`/sections/${n.s.id}/`}>All {n.s.name.toLowerCase()} news →</a>
              </div>
              {n.latest.length > 0 && (
                <div class="n5-col n5-latest">
                  <span class="n5-h">Latest</span>
                  {n.latest.map((p: any) => <a href={`/articles/${p.id}/`}>{p.data.title}</a>)}
                </div>
              )}
            </div>
          </li>
        ))}
        <li class="n5-item n5-r">
          <a class="n5-btn" href="/signals/" aria-current={['signals', 'guides'].includes(section ?? '') ? 'page' : undefined}>Analysis</a>
          <div class="n5-panel n5-desc">
            <a href="/signals/"><b>Procurement briefings</b><span>What changed, rated by urgency, with the first action to take</span></a>
            <a href="/guides/"><b>Guides</b><span>Tariffs, freight bids, fuel surcharges, AI and supplier risk</span></a>
            <a href="/glossary/"><b>Glossary</b><span>Procurement and trade terms in plain language</span></a>
            <a href="/archive/"><b>All stories</b><span>Every article, newest first</span></a>
          </div>
        </li>
        <li class="n5-item n5-r">
          <a class="n5-btn" href="/outlook/" aria-current={['cost-monitor', 'outlook', 'trackers'].includes(section ?? '') ? 'page' : undefined}>Data &amp; tools</a>
          <div class="n5-panel n5-desc">
            <a href="/outlook/"><b>Category outlook</b><span>Negotiating leverage, supply risk and our move in 12 categories</span></a>
            <a href="/cost-monitor/"><b>Price trends</b><span>Monthly producer prices for steel, freight, resins and more</span></a>
            <a href="/trackers/tariff-deadlines/"><b>Tariff deadlines</b><span>Dates when duties start, change or expire</span></a>
            <a href="/software/finder/"><b>Software finder</b><span>Four questions to a procurement software shortlist</span></a>
          </div>
        </li>
      </ul>
      <div class="n5-right">
        <div class="n5-item n5-r n5-sw">
          <a class="n5-btn" href="/software/" aria-current={section === 'software' ? 'page' : undefined}>Software rankings</a>
          <div class="n5-panel n5-swp">
            <span class="n5-h">Ranked by our analysts, with G2 ratings</span>
            {SOFTWARE.categories.map((c) => <a href={`/software/${c.slug}/`}>{c.name}<span class={`dd-st ${status(c)}`}>{status(c) === 'ranked' ? 'Ranked' : 'Coming soon'}</span></a>)}
            <a class="n5-all" href="/software/finder/">Not sure what you need? Use the software finder →</a>
          </div>
        </div>
        <a class="n5-search" href="/search/" aria-label="Search"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg></a>
      </div>
    </div>
    <div class="mnav" id="mnav" hidden>
      <div class="wrap">
        <form action="/search/" method="get" role="search" class="mnav-search">
          <label class="sr-only" for="q-m">Search Procurement Signal</label>
          <input id="q-m" name="q" type="search" placeholder="Search stories" />
          <button type="submit">Search</button>
        </form>
        <div class="mnav-group"><span>Sections</span>{SECTIONS.map((sx) => <a href={`/sections/${sx.id}/`}>{sx.name}</a>)}</div>
        <div class="mnav-group"><span>Analysis</span><a href="/signals/">Procurement briefings</a><a href="/guides/">Guides</a><a href="/glossary/">Glossary</a></div>
        <div class="mnav-group"><span>Data and tools</span><a href="/cost-monitor/">Price trends by category</a><a href="/trackers/tariff-deadlines/">Tariff deadlines</a><a href="/outlook/">Category outlook</a></div>
        <div class="mnav-group"><span>Software</span><a href="/software/">Software rankings</a><a href="/software/finder/">Software finder</a></div>
      </div>
    </div>
  </nav>
  <LiveBar />
  <main class="wrap"><slot /></main>
  <div id="newsletter"><NewsletterBand /></div>
  <footer>
    <div class="wrap">
      <div class="cols">
        <div>
          <div class="wordmark"><span class="wm-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>{SITE.name}</div>
          <p style="max-width:360px;margin:10px 0 0">{SITE.description}</p>
        </div>
        <nav aria-label="Footer">
          <a href="/about/">About us</a>
          <a href="/trackers/">Trackers</a>
          <a href="/cost-monitor/">Price trends by category</a>
          <a href="/categories/">Categories</a>
          <a href="/software/">Software rankings</a>
          <a href="/software/finder/">Software finder</a>
          <a href="/editorial-standards/">Editorial standards</a>
          <a href="/guides/">Guides</a>
          <a href="/glossary/">Glossary</a>
          <a href="/archive/">Archive</a>
          <a href="/rss.xml">RSS feed</a>
          <a href="/sitemap-index.xml">Sitemap</a>
        </nav>
      </div>
      <div class="fine">© {new Date().getFullYear()} {SITE.name}. An independent publication. Stories link to their original sources.</div>
    </div>
  </footer>
<script is:inline>
  (() => {
    const b = document.querySelector('.mnav-btn'), m = document.getElementById('mnav');
    if (b && m) b.addEventListener('click', () => { const open = b.getAttribute('aria-expanded') === 'true'; b.setAttribute('aria-expanded', String(!open)); m.hidden = open; });
  })();
  (() => {
    const nav = document.querySelector('.nav5'); if (!nav) return;
    const onScroll = () => nav.classList.toggle('stuck', scrollY > 170);
    addEventListener('scroll', onScroll, { passive: true }); onScroll();
  })();
  (() => {
    const bar = document.querySelector('.progress');
    if (!bar) return;
    const onScroll = () => {
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      bar.style.width = max > 0 ? (h.scrollTop / max) * 100 + '%' : '0';
    };
    addEventListener('scroll', onScroll, { passive: true }); onScroll();
  })();
</script>
</body>
</html>
